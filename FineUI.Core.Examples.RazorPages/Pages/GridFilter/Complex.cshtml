@page
@model FineUI.Core.Examples.RazorPages.Pages.GridFilter.ComplexModel
@{
    ViewBag.Title = "GridFilter/Complex";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()"
            AllowFilters="true" OnFilterChanged="@Url.Handler("Grid1_FilterChanged")" OnFilterChangedFields="Grid1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" EnableFilter="true">
                <Filter EnableMultiConditions="true" MatcherDefault="any">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="等于" Value="equal" />
                            <f:ListItem Text="包含" Value="contain" Selected="true" />
                            <f:ListItem Text="开始于" Value="start" />
                            <f:ListItem Text="结束于" Value="end" />
                        </f:DropDownList>
                    </Operator>
                </Filter>
            </f:RenderField>
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" EnableFilter="true">
                <Filter>
                    <Field>
                        <f:RadioButtonList>
                            <f:RadioItem Text="男" Value="1" />
                            <f:RadioItem Text="女" Value="0" />
                        </f:RadioButtonList>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" EnableFilter="true">
                <Filter EnableMultiConditions="true">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="大于" Value="greater" Selected="true" />
                            <f:ListItem Text="小于" Value="less" />
                            <f:ListItem Text="等于" Value="equal" />
                        </f:DropDownList>
                    </Operator>
                    <Field>
                        <f:NumberBox NoDecimal="true" NoNegative="true"></f:NumberBox>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" EnableFilter="true">
                <Filter>
                    <Field>
                        <f:RadioButtonList>
                            <f:RadioItem Text="在校" Value="true" />
                            <f:RadioItem Text="已离校" Value="false" />
                        </f:RadioButtonList>
                    </Field>
                </Filter>
            </f:RenderCheckField>
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" EnableFilter="true">
                <Filter>
                    <Field>
                        <f:CheckBoxList ColumnNumber="1">
                            <f:CheckItem Text="材料科学与工程系" Value="材料科学与工程系" />
                            <f:CheckItem Text="化学系" Value="化学系" />
                            <f:CheckItem Text="物理系" Value="物理系" />
                            <f:CheckItem Text="数学系" Value="数学系" />
                            <f:CheckItem Text="自动化系" Value="自动化系" />
                        </f:CheckBoxList>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" EnableFilter="true">
                <Filter>
                    <Field>
                        <f:DropDownList ID="groupList" EnableMultiSelect="true" AutoSelectFirstItem="false" MultiSelectMode="Tags" Items="@ViewBag.groupListItems">
                        </f:DropDownList>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" EnableFilter="true">
                <Filter EnableMultiConditions="true">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="大于" Value="greater" Selected="true" />
                            <f:ListItem Text="小于" Value="less" />
                            <f:ListItem Text="等于" Value="equal" />
                        </f:DropDownList>
                    </Operator>
                    <Field>
                        <f:DatePicker DateFormatString="yyyy/MM/dd"></f:DatePicker>
                    </Field>
                </Filter>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br>
    <br>


    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
