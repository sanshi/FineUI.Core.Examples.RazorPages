@page
@model FineUI.Core.Examples.RazorPages.Pages.GridFilter.MultiInitValueModel
@{
    ViewBag.Title = "GridFilter/MultiInitValue";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@ViewBag.Grid1DataSource" FilteredData="@ViewBag.Grid1FilteredData"
        AllowFilters="true" OnFilterChanged="@Url.Handler("Grid1_FilterChanged")" OnFilterChangedFields="Grid1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" EnableFilter="true">
                <Filter EnableMultiConditions="true" MatcherDefault="any">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="等于" Value="equal" />
                            <f:ListItem Text="包含" Value="contain" Selected="true" />
                            <f:ListItem Text="开始于" Value="start" />
                            <f:ListItem Text="结束于" Value="end" />
                        </f:DropDownList>
                    </Operator>
                </Filter>
            </f:RenderField>
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>
    <f:Button ID="btnUpdateFilteredData" CssClass="marginr" Text="后台更新过滤数据" OnClick="@Url.Handler("btnUpdateFilteredData_Click")" OnClickFields="Grid1">
    </f:Button>
    <br />
    <br />

    <f:Label ID="labResult" EncodeText="false" Text="@ViewBag.labResultText"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}