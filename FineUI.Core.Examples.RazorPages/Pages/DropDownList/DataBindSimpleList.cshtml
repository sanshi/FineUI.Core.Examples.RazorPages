@page
@model FineUI.Core.Examples.RazorPages.Pages.DropDownList.DataBindSimpleListModel
@{
    ViewBag.Title = "DropDownList/DataBindSimpleList";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（绑定到简单列表）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" DataSource="@ViewBag.DropDownList1DataSource">
            </f:DropDownList>
            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="@Url.Handler("btnSelectItem6_Click")"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="@Url.Handler("btnGetSelection_Click")" OnClickFields="DropDownList1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}

