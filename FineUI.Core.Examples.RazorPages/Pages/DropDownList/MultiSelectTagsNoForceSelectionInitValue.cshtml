@page
@model FineUI.Core.Examples.RazorPages.Pages.DropDownList.MultiSelectTagsNoForceSelectionInitValueModel
@{
    ViewBag.Title = "DropDownList/MultiSelectTagsNoForceSelectionInitValue";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（多选，可编辑，用户输入值）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableMultiSelect="true" EnableEdit="true" ForceSelection="false" MultiSelectMode="Tags"
                    Text="@ViewBag.DropDownList1Text" SelectedValueArray="@ViewBag.DropDownList1SelectedValueArray">
                <f:ListItem Text="可选项1" Value="Value1" Selected="true" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" Selected="true" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="@Url.Handler("btnSelectItem6_Click")"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="@Url.Handler("btnGetSelection_Click")" OnClickFields="DropDownList1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在初次加载时显示列表之外的自定义文字，以及真实选项与自定义初值的组合。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>核对自定义初始文字</h3>
        <ol>
            <li>
                打开页面后查看输入区。<br />
                结果：初始显示<code>可选项1</code>、<code>可选项4</code>和<code>初始自定义值1</code>三个标签；前两项来自列表，第三项保留列表之外的自定义文字。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SelectedValueArray</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：后台用 <code>UIHelper</code> 设置选择；读取当前值时由客户端作为请求参数提交。</li>
            <li><code>ForceSelection</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：为 <code>false</code> 时允许保存列表之外的用户输入；为 <code>true</code> 时需要匹配现有选项。 本页声明值为 <code>false</code>。</li>
            <li><code>Text</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：提供本页的初始显示文字。</li>
        </ul>
    </section>
}
