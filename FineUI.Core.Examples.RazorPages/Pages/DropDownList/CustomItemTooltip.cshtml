@page
@model FineUI.Core.Examples.RazorPages.Pages.DropDownList.CustomItemTooltipModel
@{
    ViewBag.Title = "DropDownList/CustomItemTooltip";
    var F = Html.F();
}

@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="自定义列表项" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" DataTextField="Name" DataValueField="Id" DataSource="@DataSourceUtil.GetDataTable()">
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="@Url.Handler("btnGetSelection_Click")" OnClickFields="DropDownList1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>




    @{
        DropDownList DropDownList1 = F.GetControl<DropDownList>("DropDownList1");

        // 视图中设置控件的DataSource属性，会延迟到页面渲染时才调用DataBind函数。如果需要在视图中访问Items属性，需要手工调用DataBind函数。
        DropDownList1.DataBind();

        // 下拉列表的列表项没有 Desc 信息，所以需要遍历数据源
        var index = 0;
        foreach (System.Data.DataRow row in (DropDownList1.DataSource as System.Data.DataTable).Rows)
        {
            DropDownList1.Items[index].Attributes["data-qtip"] = String.Format("<div class=\"item-text\">{0}（{2}）</div><div class=\"item-desc\">{1}</div>", row["Name"], row["Desc"], row["Id"]);
            index++;
        }

    }

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>为人员下拉项设置悬停提示，保持选中文字和业务值独立。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看数据项提示</h3>
        <ol>
            <li>
                展开面板，将鼠标移到“张萍萍”的选项上。<br />
                结果：显示包含该人员信息的悬停提示，选择值仍为 101。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：在页面视图上，通过遍历数据源来更新下拉列表每一项的属性。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataBind()</code>：在视图访问 Items 前显式绑定，确保选项已经生成。</li>
            <li><code>Attributes[&quot;data-qtip&quot;]</code>：遍历数据源时为对应列表项写入提示信息。</li>
        </ul>
    </section>
}
