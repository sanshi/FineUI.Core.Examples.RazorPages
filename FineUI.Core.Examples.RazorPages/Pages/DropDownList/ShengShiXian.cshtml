@page
@model FineUI.Core.Examples.RazorPages.Pages.DropDownList.ShengShiXianModel
@{
    ViewBag.Title = "DropDownList/ShengShiXian";
    var F = Html.F();
}


@section body {
    
    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="中国省市县联动">
        <Items>
            <f:DropDownList ID="ddlSheng" Label="省份" ShowRedStar="true" CompareType="String" CompareValue="-1" CompareOperator="NotEqual" CompareMessage="请选择省份！" Items="@ViewBag.ShengItems" OnSelectedIndexChanged="@Url.Handler("ddlSheng_SelectedIndexChanged")" OnSelectedIndexChangedFields="SimpleForm1">
            </f:DropDownList>
            <f:DropDownList ID="ddlShi" Label="地区市" ShowRedStar="true" CompareType="String" CompareValue="-1" CompareOperator="NotEqual" CompareMessage="请选择地区市！" Enabled="false" OnSelectedIndexChanged="@Url.Handler("ddlShi_SelectedIndexChanged")" OnSelectedIndexChangedFields="SimpleForm1">
                <f:ListItem Text="选择地区市" Value="-1"></f:ListItem>
            </f:DropDownList>
            <f:DropDownList ID="ddlXian" ShowRedStar="true" CompareType="String" CompareValue="-1" CompareOperator="NotEqual" CompareMessage="请选择县区市！" Label="县区市" Enabled="false">
                <f:ListItem Text="选择县区市" Value="-1"></f:ListItem>
            </f:DropDownList>
            <f:Button ID="btnSubmit" Text="获取选中的省市县" _ValidateForms="SimpleForm1" ValidateTarget="Top" OnClick="@Url.Handler("btnSubmit_Click")" OnClickFields="SimpleForm1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false" CssStyle="font-weight:bold;">
    </f:Label>

}

