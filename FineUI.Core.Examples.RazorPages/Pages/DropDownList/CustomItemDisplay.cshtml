@page
@model FineUI.Core.Examples.RazorPages.Pages.DropDownList.CustomItemDisplayModel
@{
    ViewBag.Title = "DropDownList/CustomItemDisplay";
    var F = Html.F();
}

@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="自定义列表项" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" DataTextField="Name" DataValueField="Id" DataSource="@DataSourceUtil.GetDataTable()">
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="@Url.Handler("btnGetSelection_Click")" OnClickFields="DropDownList1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>




    @{
        DropDownList DropDownList1 = F.GetControl<DropDownList>("DropDownList1");

        // 视图中设置控件的DataSource属性，会延迟到页面渲染时才调用DataBind函数。如果需要在视图中访问Items属性，需要手工调用DataBind函数。
        DropDownList1.DataBind();

        // 下拉列表的列表项没有 Desc 信息，所以需要遍历数据源
        var index = 0;
        foreach (System.Data.DataRow row in (DropDownList1.DataSource as System.Data.DataTable).Rows)
        {
            DropDownList1.Items[index].Display = String.Format("<div class=\"item-text\">{0}（{2}）</div><div class=\"item-desc\">{1}</div>", row["Name"], row["Desc"], row["Id"]);
            index++;
        }

    }

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>用模板或逐项处理自定义人员选项外观，选中后只显示姓名并提交人员标识。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>区分选项模板和选中文字</h3>
        <ol>
            <li>
                展开面板选择<code>张萍萍</code>这一项。<br />
                结果：面板可同时显示姓名、描述等模板内容；选中后输入区使用姓名，业务值为 <code>101</code>。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：在页面视图上，通过遍历数据源来更新<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>每一项的属性。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataTextField</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：从指定字段取得选中后显示的文字。 本页声明值为 <code>Name</code>。</li>
        </ul>
    </section>
}
