@page
@model FineUI.Core.Examples.RazorPages.Pages.Button.ButtonCustomModel
@{
    ViewBag.Title = "Button/ButtonCustom";
    var F = Html.F();
}

@section head {

    <style>
        .bgbtn {
            background-image: url(@Url.Content("~/res/images/login.png")) !important;
            width: 320px;
            height: 50px;
            border-width: 0 !important;
            background-color: transparent !important;
        }
    </style>

}

@section body {

    <f:Button ID="Button1" Text="普通按钮" Size="Large" OnClick="@Url.Handler("Button1_Click")" />
    <br />
    <br />

    <f:Button ID="Button2" Text="" CssClass="bgbtn" OnClick="@Url.Handler("Button2_Click")" />

}
