@page
@model FineUI.Core.Examples.RazorPages.Pages.Button.ButtonGroupChangeTextModel
@{
    ViewBag.Title = "Button/ButtonGroupChangeText";
    var F = Html.F();
}

@section body {

    <f:Panel ID="Panel1" IsFluid="true" ShowBorder="true" BodyPadding="10" Height="300" Title="面板">
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:ButtonGroup ID="ButtonGroup1">
                        <f:Button ID="Button1" Text="按钮一" IconAlign="Top" Icon="Email"  />
                        <f:Button ID="Button2" Text="按钮二" IconAlign="Bottom" Icon="Star"  />
                        <f:Button ID="Button3" Text="按钮三" IconAlign="Top" IconFont="_Camera"  />
                        <f:Button ID="Button4" Text="按钮四" IconAlign="Bottom" IconFont="_Phone"  />
                    </f:ButtonGroup>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Button CssClass="marginr" ID="btnChangeButtonText" Text="修改[按钮四]的文本" OnClick="@Url.Handler("btnChangeButtonText_Click")" OnClickParameter1="@(Parameter.FromFunction("text", "getButton4TextPostbackValue"))"></f:Button>
            <f:Button ID="btnShowHideButton" Text="显示隐藏[按钮四]" OnClick="@Url.Handler("btnShowHideButton_Click")" OnClickParameter1="@(Parameter.FromFunction("hidden", "getButton4HiddenPostbackValue"))"></f:Button>
        </Items>
    </f:Panel>
    <br />
    <f:ButtonGroup ID="ButtonGroup2">
        <f:Button ID="Button5" Text="按钮五" IconAlign="Top" Icon="Email"  />
        <f:Button ID="Button6" Text="按钮六" IconAlign="Bottom" Icon="Star"  />
        <f:Button ID="Button7" Text="按钮七" IconAlign="Top" IconFont="_Camera"  />
        <f:Button ID="Button8" Text="按钮八" IconAlign="Bottom" IconFont="_Phone"  />
    </f:ButtonGroup>
    <br />
    <f:Button CssClass="marginr" ID="btnChangeButtonText2" Text="修改[按钮八]的文本" OnClick="@Url.Handler("btnChangeButtonText2_Click")" OnClickParameter1="@(Parameter.FromFunction("text", "getButton8TextPostbackValue"))"></f:Button>
    <f:Button ID="btnShowHideButton2" Text="显示隐藏[按钮八]" OnClick="@Url.Handler("btnShowHideButton2_Click")" OnClickParameter1="@(Parameter.FromFunction("hidden", "getButton8HiddenPostbackValue"))"></f:Button>

}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getButton4TextPostbackValue() {
            return F.ui.Button4.getText();
        }

        function getButton4HiddenPostbackValue() {
            return F.ui.Button4.isHidden();
        }

        function getButton8TextPostbackValue() {
            return F.ui.Button8.getText();
        }

        function getButton8HiddenPostbackValue() {
            return F.ui.Button8.isHidden();
        }

    </script>
}
