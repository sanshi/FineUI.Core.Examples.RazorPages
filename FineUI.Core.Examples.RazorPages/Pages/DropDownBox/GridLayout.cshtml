@page
@model FineUI.Core.Examples.RazorPages.Pages.DropDownBox.GridLayoutModel
@{
    ViewBag.Title = "DropDownBox/GridLayout";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉表格（复杂布局）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" DataControlID="Grid1" EnableMultiSelect="true" MatchFieldWidth="false">
                <PopPanel>
                    <f:Panel ID="Panel1" BodyPadding="10" Width="650" Height="300" Hidden="true" ShowBorder="true" ShowHeader="false" Layout="VBox"
                        BoxConfigSpace="5">
                        <Items>
                            <f:Form ShowBorder="false" ShowHeader="false" RemoveLastFieldsMargin="true">
                                <Rows>
                                    <f:FormRow>
                                        <Items>
                                            <f:TwinTriggerBox Width="300" EmptyText="在姓名中查找" ShowLabel="false" ID="ttbSearch" ShowTrigger1="false"
                                                Trigger1Icon="Clear" Trigger2Icon="Search" OnTrigger1Click="@Url.Handler("ttbSearch_Trigger1Click")"
                                                OnTrigger1ClickFields="Panel1" OnTrigger2Click="@Url.Handler("Grid1_DoReBind")" OnTrigger2ClickFields="Panel1">
                                            </f:TwinTriggerBox>
                                            <f:RadioButtonList ID="rblAtSchool" Label="是否在校" OnSelectedIndexChanged="@Url.Handler("Grid1_DoReBind")"
                                                OnSelectedIndexChangedFields="Panel1">
                                                <f:RadioItem Text="全部" Value="-1" Selected="true" />
                                                <f:RadioItem Text="在校" Value="1" />
                                                <f:RadioItem Text="离校" Value="0" />
                                            </f:RadioButtonList>
                                        </Items>
                                    </f:FormRow>
                                </Rows>
                            </f:Form>
                            <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name"
                                EnableCheckBoxSelect="true" AllowPaging="true" IsDatabasePaging="true" PageSize="5" EnableMultiSelect="true"
                                KeepCurrentSelection="true" OnPageIndexChanged="@Url.Handler("Grid1_DoReBind")" OnPageIndexChangedFields="Panel1"
                                DataSource="@ViewBag.Grid1DataSource" RecordCount="@ViewBag.Grid1RecordCount">
                                <Columns>
                                    <f:RowNumberField />
                                    <f:RenderField HeaderText="姓名" DataField="Name" />
                                    <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                                    <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                                    <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                                    <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                                    <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                                </Columns>
                            </f:Grid>
                        </Items>
                    </f:Panel>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="@Url.Handler("btnGetSelection_Click")" OnClickFields="DropDownBox1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}



@section exampleDescription {
    <section aria-label="页面描述">
        <p>在含姓名搜索、在校筛选和分页的面板中多选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>筛选后选择人员</h3>
        <ol>
            <li>
                展开面板后的<strong class="example-control-reference" data-example-control="ttbSearch"
                    title="在姓名中查找">在姓名中查找</strong>输入框中输入<code>陈</code>，点击搜索图标。<br />
                结果：后台按姓名过滤表格，只显示匹配“陈”的记录，分页回到第一页。
            </li>
            <li>
                在结果中选择<code>陈萍萍</code>，再点击获取值按钮。<br />
                结果：读取结果包含陈萍萍及其行标识 <code>101</code>。
            </li>
            <li>
                点击搜索框清空图标。<br />
                结果：姓名关键词清除，表格重新显示未按姓名过滤的数据。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>筛选在校状态</h3>
        <ol>
            <li>
                在面板中选择<code>在校</code>或“离校”。<br />
                结果：表格按所选状态重新加载，原选择集合与当前页可见行分开保存。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataControlID</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="请从下拉表格中选择">请从下拉表格中选择</strong>）：指定弹出面板中提供选择数据的控件。 本页声明值为 <code>Grid1</code>。</li>
            <li><code>IsDatabasePaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：为 <code>true</code>
                时后台按当前页加载；为 <code>false</code> 时浏览器对已加载数据分页。 本页声明值为 <code>true</code>。</li>
            <li><code>KeepCurrentSelection</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：在继续选择或翻页时保留已有选择。 本页声明值为 <code>true</code>。</li>
            <li><code>OnPageIndexChanged</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：翻页后重新取得当前页数据并绑定。
            </li>
        </ul>
    </section>
}
