@page
@model FineUI.Core.Examples.RazorPages.Pages.DropDownBox.GridLayoutAlwaysDisplayModel
@{
    ViewBag.Title = "DropDownBox/GridLayoutAlwaysDisplay";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="始终显示弹出面板" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下面表格中选择" DataControlID="Grid1" EnableMultiSelect="true" MatchFieldWidth="false"
                           PopPanelID="Panel1" AlwaysDisplayPopPanel="true" AutoShowClearIcon="true">
            </f:DropDownBox>
            <f:Panel ID="Panel1" BodyPadding="10" Height="300" ShowBorder="true" ShowHeader="false" Layout="VBox" BoxConfigSpace="5">
                <Items>
                    <f:Form ShowBorder="false" ShowHeader="false" RemoveLastFieldsMargin="true">
                        <Rows>
                            <f:FormRow>
                                <Items>
                                    <f:TwinTriggerBox Width="300" EmptyText="在姓名中查找" ShowLabel="false" ID="ttbSearch"
                                                      ShowTrigger1="false" Trigger1Icon="Clear" Trigger2Icon="Search"
                                                      OnTrigger1Click="@Url.Handler("ttbSearch_Trigger1Click")" OnTrigger1ClickFields="Panel1"
                                                      OnTrigger2Click="@Url.Handler("Grid1_DoReBind")" OnTrigger2ClickFields="Panel1">
                                    </f:TwinTriggerBox>
                                    <f:RadioButtonList ID="rblAtSchool" Label="是否在校" 
                                                       OnSelectedIndexChanged="@Url.Handler("Grid1_DoReBind")" OnSelectedIndexChangedFields="Panel1">
                                        <f:RadioItem Text="全部" Value="-1" Selected="true" />
                                        <f:RadioItem Text="在校" Value="1" />
                                        <f:RadioItem Text="离校" Value="0" />
                                    </f:RadioButtonList>
                                </Items>
                            </f:FormRow>
                        </Rows>
                    </f:Form>
                    <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
                            AllowPaging="true" IsDatabasePaging="true" PageSize="5" EnableMultiSelect="true" KeepCurrentSelection="true"
                            OnPageIndexChanged="@Url.Handler("Grid1_DoReBind")" OnPageIndexChangedFields="Panel1" DataSource="@ViewBag.Grid1DataSource" RecordCount="@ViewBag.Grid1RecordCount">
                        <Columns>
                            <f:RowNumberField />
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                        </Columns>
                    </f:Grid>
                </Items>
            </f:Panel>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="@Url.Handler("btnGetSelection_Click")" OnClickFields="DropDownBox1"></f:Button>

    <f:Button ID="btnClearValue" Text="清空下拉框的值" ClickHandler="onClearValueClick"></f:Button>
    <br>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onClearValueClick(event) {
            F.ui.DropDownBox1.clearValue();
        }
    </script>


}


