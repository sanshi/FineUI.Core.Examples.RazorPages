@page
@model FineUI.Core.Examples.RazorPages.Pages.Other.FieldLabelStyleModel
@{
    ViewBag.Title = "Other/FieldLabelStyle";
    var F = Html.F();
}


@section head {

    <style>
        .red .f-field-fieldlabel {
            color: Red;
            font-weight: bold;
        }

        .blue .f-field-fieldlabel {
            color: Blue;
            font-weight: normal;
        }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" LabelAlign="Right" Title="简单表单">
        <Items>
            <f:TextBox Label="用户名" EmptyText="输入用户名" Text="张三" ID="tbxUserName" CssClass="red">
            </f:TextBox>
            <f:TextBox Label="密码" TextMode="Password" ID="tbxPassword" CssClass="red">
            </f:TextBox>
        </Items>
        <Toolbars>
            <f:Toolbar ToolbarAlign="Right" Position="Bottom">
                <Items>
                    <f:Button ID="btnSwitchClass" Text="改变 Label 的样式" OnClick="@Url.Handler("btnSwitchClass_Click")" OnClickParameter1="@(Parameter.FromFunction("hasClassRed", "gettbxUserNameHasClassRedPostbackValue"))"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>



}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function gettbxUserNameHasClassRedPostbackValue() {
            return F.ui.tbxUserName.el.hasClass('red');
        }

    </script>
}
