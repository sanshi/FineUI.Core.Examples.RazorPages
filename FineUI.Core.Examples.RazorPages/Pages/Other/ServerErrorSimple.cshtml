@page
@model FineUI.Core.Examples.RazorPages.Pages.Other.ServerErrorSimpleModel
@{
    ViewBag.Title = "Other/ServerErrorSimple";
    var F = Html.F();
}


@section body {

    @{
        F.PageManager.SimpleError(true);
    }


    <f:Button ID="Button5" OnClick="@Url.Handler("Button5_Click")" Text="服务器异常（500）"></f:Button>

    <br>
    <br>
    注：本示例仅作演示，实际应用中请在Web.config中增加SimpleError配置项，以便在整个项目中保持统一。



}

