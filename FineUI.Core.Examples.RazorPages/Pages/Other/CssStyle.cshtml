@page
@model FineUI.Core.Examples.RazorPages.Pages.Other.CssStyleModel
@{
    ViewBag.Title = "Other/CssStyle";
    var F = Html.F();
}


@section head {

    <style>
        .red {
            font-weight: bold;
            color: Red;
        }

        .green {
            font-weight: bold;
            font-style: italic;
            font-size: 1.5em;
            color: Green;
        }
    </style>

}

@section body {

    <f:Label ID="Label1" Text="文本一，注意观察文本的样式">
    </f:Label>
    <br />
    <f:Button ID="Button1" OnClick="@Url.Handler("Button1_Click")" Text="通过 CssStyle 修改文本的样式"></f:Button>
    <f:Button ID="Button3" OnClick="@Url.Handler("Button3_Click")" Text="清空 CssStyle 设置的样式"></f:Button>

    <br />
    <br />

    <f:Label ID="Label2" Text="文本二，注意观察文本的样式">
    </f:Label>
    <br />
    <f:Button ID="Button2" OnClick="@Url.Handler("Button2_Click")" OnClickParameter1="@(Parameter.FromFunction("hasClassRed", "getLabel2HasClassRedPostbackValue"))" Text="通过 CssClass 修改文本的样式"></f:Button>
    <f:Button ID="Button4" OnClick="@Url.Handler("Button4_Click")" Text="清空 CssClass 设置的样式"></f:Button>



}

@section script {
    <script>
        function clearLabelStyle() {
            F.ui.Label1.el.attr('style', '');
        }
    </script>


    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getLabel2HasClassRedPostbackValue() {
            return F.ui.Label2.el.hasClass('red');
        }

    </script>
}
