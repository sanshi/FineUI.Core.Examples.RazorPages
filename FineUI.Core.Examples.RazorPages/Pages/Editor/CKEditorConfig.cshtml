@page
@model FineUI.Core.Examples.RazorPages.Pages.Editor.CKEditorConfigModel
@{
    ViewBag.Title = "Editor/CKEditorConfig";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false" Title="表单">
        <Items>
            <f:HtmlEditor Label="文本编辑器" ID="HtmlEditor1"
                          Editor="CKEditor" BasePath="@Url.Content("~/res/third-party/ckeditor/")" ToolbarSet="Full" Height="350" Text="<p>FineUI.Core<br>.NET 企业级全栈 UI 框架<br><br>支持的浏览器<br>Chrome、Firefox、Safari、Edge<br><br>相关链接<br>首页：http://fineui.com/<br>示例：https://fineui.com/core/demo-mvc/</p>">
                <Options>
                    <f:OptionItem Key="uiColor" Value="#aed0ea" />
                    <f:OptionItem Key="language" Value="zh" />
                    <f:OptionItem Key="toolbar"
                                  Value="[['Bold','Italic','Underline','Strike'],['NumberedList','BulletedList'],['JustifyLeft','JustifyCenter','JustifyRight'],['Link','Unlink'],['Source']]"
                                  PersistOriginal="true" />
                </Options>
            </f:HtmlEditor>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Button ID="Button2" CssClass="marginr" Text="设置编辑器的值" OnClick="@Url.Handler("Button2_Click")"></f:Button>
    <f:Button ID="Button1" Text="获取编辑器的值" OnClick="@Url.Handler("Button1_Click")" OnClickParameter1="@(Parameter.FromFunction("text", "getHtmlEditor1TextPostbackValue"))"></f:Button>

    <br>
    <br>
    注：本示例通过 Options 属性设置 CKEditor 的背景色（浅蓝色），语言（繁体中文）和工具栏（自定义）。参考文档：http://docs.ckeditor.com/#!/guide/dev_configuration


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getHtmlEditor1TextPostbackValue() {
            return F.ui.HtmlEditor1.getValue();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>通过 Options 覆盖 CKEditor 的默认配置，重点对照自定义工具栏或菜单。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>对照自定义配置</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>的顶部工具栏与菜单区域。<br />结果：工具栏使用本页配置的按钮组合。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Options</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>）：把本页提供的配置对象传给 CKEditor；具体键名使用该编辑器自己的 API。</li>
    </ul>
</section>
}
