@page
@model FineUI.Core.Examples.RazorPages.Pages.GridCard.CardMultiSelectShowCheckBoxAutoHideModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/js/gridcard.js";
    ViewBag.Title = "GridCard/CardMultiSelectShowCheckBoxAutoHide";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            DataSource="@DataSourceUtil.GetDataTable()"
            Height="500" DisplayType="Card" CardRendererFunction="renderCard" EnableCheckBoxSelect="true" CheckBoxSelectAutoHide="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
    </f:Grid>
    <br />

    <f:Button Text="选中了哪些行（客户端）" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button Text="选中第 2, 6, 8 行（客户端）" CssClass="marginr" ClickHandler="onSelectRowsClick"></f:Button>
    <br>
    <br>
    <f:Button Text="选中了哪些行" CssClass="marginr" ID="Button1" OnClick="@Url.Handler("Button1_Click")" OnClickParameter1="@(new Parameter("selected", "getGridSelectedRows()"))"></f:Button>

    <f:Button Text="选中第 2, 6, 8 行" CssClass="marginr" ID="Button2" OnClick="@Url.Handler("Button2_Click")"></f:Button>
    <br>
    <br>
    <f:Button Text="选中了哪些行（自定义回发）" CssClass="marginr" ID="Button3" ClickHandler="onButton3Click"></f:Button>
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script src="~/res/js/gridcard.js"></script>

    <script>

        function getGridSelectedRows() {
            var result = [], grid = F.ui.Grid1;

            $.each(grid.getSelectedRows(true), function (index, item) {
                var itemArr = [];
                itemArr.push(item.id);
                itemArr.push(item.text);
                itemArr.push(item.values.Gender);
                itemArr.push(item.values.Major);

                result.push(itemArr);
            });

            return F.toJSON(result);
        }


        function onButton3Click(event) {
            var grid = F.ui.Grid1;
            if (!grid.hasSelection()) {
                F.alert('没有选中项！');
                return;
            }


            // 触发后台事件
            F.doPostBack({
                url: '@Url.Handler("Button1_Click")',
                params: {
                    'selected': getGridSelectedRows()
                }
            });
        }

        function onSelectRowsClick(event) {
            F.ui.Grid1.selectRows([1,5,7]);
        }

    </script>
}
