@page
@model FineUI.Core.Examples.RazorPages.Pages.Panel.CollapseModel
@{
    ViewBag.Title = "Panel/Collapse";
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" Title="面板一" BodyPadding="10" EnableCollapse="true" IconUrl="@Url.Content("~/res/images/16/8.png")"
             OnCollapse="@Url.Handler("Panel1_CollapseExpand")" OnCollapseParameter1="@(Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue"))"
             OnExpand="@Url.Handler("Panel1_CollapseExpand")" OnExpandParameter1="@(Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue"))">
        <Items>
            <f:Panel ID="Panel2" Title="面板二" ShowBorder="true" Height="200" BodyPadding="10" EnableCollapse="true" ShowHeader="true" Content="展开折叠这两个面板。"
                     OnCollapse="@Url.Handler("Panel2_CollapseExpand")" OnCollapseParameter1="@(Parameter.FromFunction("collapsed", "getPanel2CollapsedPostbackValue"))"
                     OnExpand="@Url.Handler("Panel2_CollapseExpand")" OnExpandParameter1="@(Parameter.FromFunction("collapsed", "getPanel2CollapsedPostbackValue"))">
            </f:Panel>
        </Items>
    </f:Panel>

}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getPanel1CollapsedPostbackValue() {
            return F.ui.Panel1.collapsed;
        }

        function getPanel2CollapsedPostbackValue() {
            return F.ui.Panel2.collapsed;
        }

    </script>
}
