@page
@model FineUI.Core.Examples.RazorPages.Pages.Toolbar.MenuDynamicButtonModel
@{
    ViewBag.Title = "Toolbar/MenuDynamicButton";
    var F = Html.F();
}


@section body {

    <f:Panel IsFluid="true" ShowBorder="true" Title="面板" BodyPadding="10" Height="300" EnableCollapse="false">
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="Button1" ClickHandler="onOpenNewWindowClick" Text="点击打开新窗体（内联按钮）"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Panel>


    @{
        Button btn = new Button();
        btn.Text = "工具栏中的按钮数（动态添加的按钮）";
        btn.OnClick = new Event("click", Url.Handler("btnDynamic_Click"), new Parameter("count", "F.ui.Toolbar1.items.length"));
        F.GetControl<Toolbar>("Toolbar1").Items.Add(btn);
    }

}

@section script {

    <script type="text/javascript">

        function onOpenNewWindowClick(event) {
            window.open('@Url.Content("~/")', '_blank');
        }

    </script>
}
