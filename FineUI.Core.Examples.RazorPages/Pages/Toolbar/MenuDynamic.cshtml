@page
@model FineUI.Core.Examples.RazorPages.Pages.Toolbar.MenuDynamicModel
@{
    ViewBag.SourceFiles = "~/wwwroot/content/toolbar/menu.xml";
    ViewBag.Title = "Toolbar/MenuDynamic";
    var F = Html.F();
}


@section body {

    <f:Panel IsFluid="true" ShowBorder="true" BodyPadding="10" Height="300" Title="面板" EnableCollapse="false">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Top" Items="@(ControlBase[])ViewBag.ToolbarItems">
            </f:Toolbar>
        </Toolbars>
    </f:Panel>



}

