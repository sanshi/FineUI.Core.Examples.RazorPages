@page
@model FineUI.Core.Examples.RazorPages.Pages.GridPaging.PageItemsPageSizeDatabaseModel
@{
    ViewBag.Title = "GridPaging/PageItemsPageSizeDatabase";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" AllowPaging="true" PageSize="5" IsDatabasePaging="true"
            RecordCount="@ViewBag.Grid1RecordCount" DataSource="@ViewBag.Grid1DataSource" Height="350">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <PageItems>
            <f:ToolbarText Text="每页记录数：">
            </f:ToolbarText>
            <f:DropDownList ID="ddlPageSize" Width="100">
                <Items>
                    <f:ListItem Text="5" Value="5" />
                    <f:ListItem Text="10" Value="10" />
                    <f:ListItem Text="15" Value="15" />
                    <f:ListItem Text="20" Value="20" />
                </Items>
                <Listeners>
                    <f:Listener Event="change" Handler="onDdlPageSizeChange"></f:Listener>
                </Listeners>
            </f:DropDownList>
        </PageItems>
        <Listeners>
            <f:Listener Event="paging" Handler="onGrid1PageIndexChanged"></f:Listener>
        </Listeners>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function doPostBackReBindGrid(event) {
            var grid1 = F.ui.Grid1;

            // 触发后台事件
            F.doPostBack({
                url: '@Url.Handler("Grid1_ReBindGrid")',
                params: {
                    fields: grid1.fields,
                    pageIndex: grid1.pageIndex,
                    pageSize: F.ui.ddlPageSize.getValue()
                }
            });

        }

        function onDdlPageSizeChange(event) {
            doPostBackReBindGrid();
        }

        function onGrid1PageIndexChanged(event) {
            doPostBackReBindGrid();
        }

    </script>
}
