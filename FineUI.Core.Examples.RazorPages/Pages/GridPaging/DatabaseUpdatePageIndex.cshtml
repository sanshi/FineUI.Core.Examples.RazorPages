@page
@model FineUI.Core.Examples.RazorPages.Pages.GridPaging.DatabaseUpdatePageIndexModel
@{
    ViewBag.Title = "GridPaging/DatabaseUpdatePageIndex";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" AllowPaging="true" PageSize="5" IsDatabasePaging="true"
            RecordCount="@ViewBag.Grid1RecordCount" DataSource="@ViewBag.Grid1DataSource" OnPageIndexChanged="@Url.Handler("Grid1_PageIndexChanged")" OnPageIndexChangedFields="Grid1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick" CssClass="marginr"></f:Button>
    <f:Button ID="btnUpdatePageIndex" Text="转到最后一页" OnClick="@Url.Handler("btnUpdatePageIndex_Click")" OnClickFields="Grid1" />
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}