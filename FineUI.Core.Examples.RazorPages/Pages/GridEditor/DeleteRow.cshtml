@page
@model FineUI.Core.Examples.RazorPages.Pages.GridEditor.DeleteRowModel
@{
    ViewBag.Title = "GridEditor/DeleteRow";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（双击编辑）" DataIDField="Id" DataTextField="Name" DataSource="@ViewBag.Grid1DataSource" AllowCellEditing="true" ClicksToEdit="2" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField EnableHeaderMenu="false" RendererFunction="renderDeleteAction"></f:RenderField>
        </Columns>
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:Button ID="btnDelete" Text="删除选中行（可删除多行）" Icon="Delete" ClickHandler="onDeleteClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="@Url.Handler("btnSubmit_Click")" OnClickFields="Grid1"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>


        function deleteRows(selectedRows) {
            // 触发后台事件
            F.doPostBack({
                url: '@Url.Handler("Grid1_DeleteRows")',
                fields: 'Grid1',
                params: {
                    selectedRows: selectedRows
                }
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;
            if (!grid1.hasSelection()) {
                F.alert('没有选中项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;行数据吗？'),
                target: '_top',
                ok: function () {
                    deleteRows(selectedRows)
                }
            });
        }

        F.ready(function () {

            var grid1 = F.ui.Grid1;
            grid1.el.on('click', 'a.action-btn.delete', function (event) {
                // 删除链接是按钮型占位地址，先取消默认导航，避免改写页面 hash。
                event.preventDefault();

                var cnode = $(this);
                var rowData = grid1.getRowData(cnode.closest('.f-grid-row'));

                F.confirm({
                    message: '删除选中行？',
                    target: '_top',
                    ok: function () {
                        deleteRows([rowData.id])
                    }
                });
            });

        });

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>把选中的行交给后台立即删除并重新绑定表格，与仅在浏览器登记待删除记录区分。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>确认后由后台删除记录</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格（双击编辑）">表格（双击编辑）</strong>选择一行或多行，点击<strong class="example-control-reference" data-example-control="btnDelete" title="删除选中行（可删除多行）">删除选中行（可删除多行）</strong>并确认。<br />结果：客户端提交本次选中行的标识，后台从示例数据中移除这些记录并重新绑定；不必再点击普通保存按钮才执行删除。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（双击编辑）">表格（双击编辑）</strong>）：删除按数据中的业务主键定位，不用删除后的行序号重新找记录。</li>
        <li><code>OnClick</code>（<strong>删除操作</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格（双击编辑）">表格（双击编辑）</strong>）：把本次选择交给后台删除处理，返回后用剩余数据重新绑定。</li>
    </ul>
</section>
}
