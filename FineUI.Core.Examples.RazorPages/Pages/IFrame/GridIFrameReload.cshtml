@page
@model FineUI.Core.Examples.RazorPages.Pages.IFrame.GridIFrameReloadModel
@{
    ViewBag.SourceFiles = "~/IFrame/GridIFrameReload/IFrameWindow";
    ViewBag.Title = "IFrame/GridIFrameReload";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" Title="@("表格 - 页面加载时间：" + DateTime.Now.ToLongTimeString())" IsFluid="true" PageSize="10" ShowBorder="true" AllowPaging="true" IsDatabasePaging="false"
            ShowHeader="true" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()" Height="550">
        <Toolbars>
            <f:Toolbar ID="Toolbar2">
                <Items>
                    <f:Button ID="btnDeleteRows" Text="删除选中行"></f:Button>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:Button ID="btnAddUser" Text="新增用户"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="窗口列" EnableHeaderMenu="false" RendererFunction="renderWindowField1" />
        </Columns>
        <Attributes>
            <f:Attribute Key="data-source-key" Value="table1"></f:Attribute>
        </Attributes>
    </f:Grid>

    <f:Window ID="Window1" Title="弹出窗体" Hidden="true" EnableIFrame="true" EnableMaximize="true" Target="Top" EnableResize="true" IsModal="true" Width="800" Height="550" CloseAction="HidePostBack">
        <Listeners>
            <f:Listener Event="close" Handler="onWindow1Close"></f:Listener>
        </Listeners>
    </f:Window>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function doCustomPostBack(Window1_closeArgument) {
            var grid1 = F.ui.Grid1;

            // 触发后台事件
            F.doPostBack({
                url: '@Url.Handler("MyCustomPostBack")',
                params: {
                    Window1_closeArgument: Window1_closeArgument,
                    Grid1_sourceKey: grid1.getAttr('data-source-key'),
                    Grid1_fields: grid1.fields
                }
            });
        }

        function onWindow1Close(event) {
            doCustomPostBack('onWindow1Close');
        }


        function renderWindowField1(value, params) {
            return '<a href="#" class="mywindowfield">编辑</a>';
        }

        // 打开窗体
        function openWindow(rowData) {

            // IFrame/GridIFrameReload/IFrameWindow?id=104&name=刘国
            var iframeWindowUrl = '@Url.Content("~/IFrame/GridIFrameReload/IFrameWindow")';
            var iframeUrl = iframeWindowUrl + '?id=' + rowData.id + '&name=' + encodeURIComponent(rowData.text);

            // 显示窗体
            F.ui.Window1.show(iframeUrl, '详细信息 - ' + rowData.text);
        }

        F.ready(function () {

            var grid = F.ui.Grid1;

            // 点击表格行中的编辑按钮
            grid.el.on('click', 'a.mywindowfield', function (event) {
                event.preventDefault();
                var rowEl = $(this).closest('.f-grid-row');
                var rowData = grid.getRowData(rowEl);

                openWindow(rowData);
            });

        });

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示子页面通知父页更新表格，同时保留当前编辑窗体。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>保留窗体并更新父页</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>点击第一行的<strong>编辑</strong>或弹出窗体入口。<br />结果：<code>iframe</code> 窗体打开当前记录，标题或地址包含本次选择的行信息；不会固定打开同一条记录。</li>
        <li>在子页面点击用于保存并继续的按钮。<br />结果：子页面通知父页面回发或执行其更新函数，父表格标题显示本次参数，编辑窗体继续保留。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：表格使用稳定的记录 <code>ID</code> 识别当前行。 本页使用<code>Id</code>。</li>
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Window1" title="弹出窗体">弹出窗体</strong>）：编辑窗体使用独立子页面。 本页使用<code>true</code>。</li>
        <li><code>IFrameUrl</code>（<strong class="example-control-reference" data-example-control="Window1" title="弹出窗体">弹出窗体</strong>）：本页根据当前记录拼接子页面地址及必要参数。</li>
        <li><code>GetCustomEventReference()</code>（<strong>子页面与父页面交互</strong>）：子页面向正确的父页面发送本页约定的更新通知。</li>
    </ul>
</section>
}
