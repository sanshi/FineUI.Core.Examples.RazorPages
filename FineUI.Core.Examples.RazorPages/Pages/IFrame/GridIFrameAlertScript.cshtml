@page
@model FineUI.Core.Examples.RazorPages.Pages.IFrame.GridIFrameAlertScriptModel
@{
    ViewBag.SourceFiles = "~/IFrame/GridIFrameAlertScript/IFrameWindow";
    ViewBag.Title = "IFrame/GridIFrameAlertScript";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" Title="@("表格 - 页面加载时间：" + DateTime.Now.ToLongTimeString())" IsFluid="true" PageSize="10" ShowBorder="true" AllowPaging="true" IsDatabasePaging="false"
            ShowHeader="true" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()" Height="550">
        <Toolbars>
            <f:Toolbar ID="Toolbar2">
                <Items>
                    <f:Button ID="btnDeleteRows" Text="删除选中行"></f:Button>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:Button ID="btnAddUser" Text="新增用户"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="窗口列" EnableHeaderMenu="false" RendererFunction="renderWindowField1" />
        </Columns>
        <Attributes>
            <f:Attribute Key="data-source-key" Value="table1"></f:Attribute>
        </Attributes>
    </f:Grid>

    <f:Window ID="Window1" Title="弹出窗体" Hidden="true" EnableIFrame="true" EnableMaximize="true" Target="Top" EnableResize="true" IsModal="true" Width="800" Height="550" CloseAction="HidePostBack">
        <Listeners>
            <f:Listener Event="close" Handler="onWindow1Close"></f:Listener>
        </Listeners>
    </f:Window>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function doCustomPostBack(Window1_closeArgument) {
            var grid1 = F.ui.Grid1;

            // 触发后台事件
            F.doPostBack({
                url: '@Url.Handler("MyCustomPostBack")',
                params: {
                    Window1_closeArgument: Window1_closeArgument,
                    Grid1_sourceKey: grid1.getAttr('data-source-key'),
                    Grid1_fields: grid1.fields
                }
            });
        }

        function onWindow1Close(event) {
            doCustomPostBack('onWindow1Close');
        }


        function renderWindowField1(value, params) {
            return '<a href="#" class="mywindowfield">编辑</a>';
        }

        // 打开窗体
        function openWindow(rowData) {

            // IFrame/GridIFrameAlertScript/IFrameWindow?id=104&name=刘国
            var iframeWindowUrl = '@Url.Content("~/IFrame/GridIFrameAlertScript/IFrameWindow")';
            var iframeUrl = iframeWindowUrl + '?id=' + rowData.id + '&name=' + encodeURIComponent(rowData.text);

            // 显示窗体
            F.ui.Window1.show(iframeUrl, '详细信息 - ' + rowData.text);
        }

        F.ready(function () {

            var grid = F.ui.Grid1;

            // 点击表格行中的编辑按钮
            grid.el.on('click', 'a.mywindowfield', function (event) {
                event.preventDefault();
                var rowEl = $(this).closest('.f-grid-row');
                var rowData = grid.getRowData(rowEl);

                openWindow(rowData);
            });

        });

    </script>
}
