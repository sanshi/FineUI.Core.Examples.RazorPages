@page
@model FineUI.Core.Examples.RazorPages.Pages.IFrame.PassValue.IFrameWindowModel
@{
    ViewData["Title"] = "IFrameWindow";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" LabelAlign="Top" ShowBorder="false" ShowHeader="false" CssClass="f-widget-content" Title="SimpleForm" BodyPadding="10" EnableCollapse="false" AutoScroll="true" IsViewPort="true">
        <Items>
            <f:RadioButtonList ID="ddlSheng" Label="请选择省份" ColumnNumber="4" ShowRedStar="true" DataSource="@DataSourceUtil.SHENG_JSON" SelectedValue="@HttpContext.Request.Query["selected"]"
                               OnSelectedIndexChanged="@Url.Handler("ddlSheng_SelectedIndexChanged")" OnSelectedIndexChangedParameter1="@(Parameter.FromFunction("province", "getCurrentControlProvincePostbackValue"))">
            </f:RadioButtonList>
        </Items>
    </f:SimpleForm>

}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlProvincePostbackValue() {
            return this.getValue();
        }

    </script>
}
