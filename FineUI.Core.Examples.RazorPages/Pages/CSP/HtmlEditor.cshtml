@page
@model FineUI.Core.Examples.RazorPages.Pages.CSP.HtmlEditorModel
@{
    ViewBag.Title = "CSP/HtmlEditor";
    var F = Html.F();
}


@section body {


    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" Title="表单">
        <Items>
            <f:HtmlEditor Label="文本编辑器" ID="HtmlEditor1" Editor="UMEditor" BasePath="~/res/third-party/umeditor/" Height="250" Text="@ViewBag.InitContent">
            </f:HtmlEditor>
            <f:TextArea ID="TextArea1" Label="多行文本框" Height="150" Text="FineUI的使命是创建 No JavaScript，No CSS，No UpdatePanel，No ViewState 的网站应用程序">
            </f:TextArea>
            <f:Button ID="Button1" Text="获取 HTML 编辑器的内容" CssClass="marginr" OnClick="@Url.Handler("Button1_Click")" OnClickParameter1="@(Parameter.FromFunction("content", "getHtmlEditor1ContentPostbackValue"))"></f:Button>
            <f:Button ID="Button2" Text="设置 HTML 编辑器的内容" OnClick="@Url.Handler("Button2_Click")" OnClickParameter1="@(Parameter.FromFunction("content", "getTextArea1ContentPostbackValue"))"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />

    <br />
    <br />

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getHtmlEditor1ContentPostbackValue() {
            return F.ui.HtmlEditor1.getValue();
        }

        function getTextArea1ContentPostbackValue() {
            return F.ui.TextArea1.getValue();
        }

    </script>


    <script type="text/javascript">

        console.log('Hello world!');

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在富文本编辑器所需的 CSP 兼容例外下，验证 HTML 内容的读取与设置。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>验证编辑器内容往返</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="获取 HTML 编辑器的内容">获取 HTML 编辑器的内容</strong>。<br />结果：后台读取编辑器当前 HTML，写入下方多行文本框。</li>
        <li>在<strong class="example-control-reference" data-example-control="TextArea1" title="多行文本框">多行文本框</strong>输入 <code>&lt;p&gt;CSP 编辑器测试&lt;/p&gt;</code>，点击设置内容按钮，再重新读取。<br />结果：编辑器显示新文字，再次读取能得到对应 HTML。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>第三方编辑器仍依赖内联脚本。本页使用专用编辑器场景基类关闭 CSP，首屏和 POST 保持相同策略。</li>
        <li>普通页面及打开编辑器弹窗的外层页面继续使用同源脚本和每请求 nonce 的严格策略。</li>
        <li>文章：<a target="_blank" href="https://fineui.com/docs/#/Questions/5000_CSP_unsafe_inline">https://fineui.com/docs/#/Questions/5000_CSP_unsafe_inline</a></li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Editor</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>）：初始为 <code>UMEditor</code>，选择本页使用的第三方富文本编辑器。</li>
        <li><code>BasePath</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>）：初始为 <code>~/res/third-party/umeditor/</code>，指定编辑器脚本、皮肤等文件的基础路径。</li>
        <li><code>CSP 兼容配置</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>）：第三方编辑器需要本页明确允许的脚本策略例外；该页面不能当作没有例外的严格 CSP 示范。</li>
    </ul>
</section>
}
