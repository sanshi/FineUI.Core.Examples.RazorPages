@page
@model FineUI.Core.Examples.RazorPages.Pages.DatePicker.DatePickerYearRangeConfirmButtonModel
@{
    ViewBag.Title = "DatePicker/DatePickerYearRangeConfirmButton";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="yyyy" Label="年份范围" EmptyText="请选择年份范围" ShowRedStar="true"
                          RangeStartDate="@ViewBag.DatePicker1RangeStartDate" RangeEndDate="@ViewBag.DatePicker1RangeEndDate"
                          MinDate="@ViewBag.DatePicker1MinDate" MaxDate="@ViewBag.DatePicker1MaxDate"
                          DisplayType="YearRange" ShowConfirmButton="true" ConfirmToSelect="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="@Url.Handler("btnSubmit_Click")" OnClickFields="SimpleForm1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}

