@page
@model FineUI.Core.Examples.RazorPages.Pages.Tree.TreeIconFontColorXmlModel
@{
    ViewBag.SourceFiles = "~/wwwroot/content/tree/tree_iconfont_randomcolor.xml";
    ViewBag.Title = "Tree/TreeIconFontColorXml";
    var F = Html.F();
}

@section head {

    <style>
        @Html.Raw(ViewBag.DynamicCSS)
    </style>

}

@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableCollapse="false" Nodes="@(TreeNode[])ViewBag.Tree1Nodes">
    </f:Tree>
    <br>

    <f:Button ID="btnGetSelectedNode" OnClick="@Url.Handler("btnGetSelectedNode_Click")" OnClickParameter1="@(Parameter.FromFunction("selectedNode", "getCurrentControlSelectedNodePostbackValue"))" CssClass="marginr" Text="获取选中的节点"></f:Button>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}

@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedNodePostbackValue() {
            return getSelectedNode();
        }

    </script>


    <script>

        function getSelectedNode() {
            var result;

            var selectedNode = F.ui.Tree1.getSelectedNode(true);
            if (selectedNode) {
                result = {
                    id: selectedNode.id,
                    text: selectedNode.text
                };
            }

            return F.toJSON(result);
        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示从 XML 节点数据读取字体图标和颜色，生成各节点的显示样式。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照节点图标颜色</h3>
    <ul>
        <li>展开<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>，对照各节点前的彩色字体图标。<br />结果：每个节点按数据源中的图标与颜色显示，节点选择和目录层级保持独立。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>IconFont</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：指定节点使用的字体图标。</li>
        <li><code>IconFontColor</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：从本页 XML 的对应字段读取，后台为节点生成颜色样式。</li>
    </ul>
</section>
}
