@page
@model FineUI.Core.Examples.RazorPages.Pages.Tree.TreeNodeExpandModel
@{
    ViewBag.Title = "Tree/TreeNodeExpand";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件"
            OnNodeExpand="@Url.Handler("Tree1_NodeExpand")" OnNodeExpandParameter1="@(Parameter.FromFunction("nodeInfo", "getCurrentControlNodeInfoPostbackValue"))"
            OnNodeCollapse="@Url.Handler("Tree1_NodeCollapse")" OnNodeCollapseParameter1="@(Parameter.FromFunction("nodeInfo", "getCurrentControlNodeInfoPostbackValue"))">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" Expanded="true" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" NodeID="suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" NodeID="xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                    </f:TreeNode>
                    <f:TreeNode Text="黄山市" NodeID="huangshan">
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlNodeInfoPostbackValue() {
            return getNodeInfo(arguments[1]);
        }

    </script>


    <script>

        function getNodeInfo(nodeId) {
            var nodeData = F.ui.Tree1.getNodeData(nodeId);

            return F.toJSON({
                id: nodeId,
                text: nodeData.text
            });
        }

    </script>

}