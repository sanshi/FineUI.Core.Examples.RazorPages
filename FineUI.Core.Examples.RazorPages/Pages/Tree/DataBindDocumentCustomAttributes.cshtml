@page
@model FineUI.Core.Examples.RazorPages.Pages.Tree.DataBindDocumentCustomAttributesModel
@{
    ViewBag.SourceFiles = "~/wwwroot/content/tree/website.xml";
    ViewBag.Title = "Tree/DataBindDocumentCustomAttributes";
    var F = Html.F();
}

@section head {

    <style>
        .f-tree-node[data-highlight=true] .f-tree-cell-text {
            font-weight: bold;
            color: red;
        }
    </style>

}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件（点击树节点回发）" Nodes="@(TreeNode[])ViewBag.Tree1Nodes"
            OnNodeClick="@Url.Handler("Tree1_NodeClick")" OnNodeClickParameter1="@(Parameter.FromFunction("nodeInfo", "getCurrentControlNodeInfoPostbackValue"))">
    </f:Tree>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>
    <br>
    注：从 XmlDocument 手工创建节点列表，并将 Xml 节点属性 Highlight 转化为树节点的 Attributes 属性。

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlNodeInfoPostbackValue() {
            return getNodeInfo(arguments[1]);
        }

    </script>


    <script>

        function getNodeInfo(nodeId) {
            var nodeData = F.ui.Tree1.getNodeData(nodeId);

            return F.toJSON({
                id: nodeId,
                text: nodeData.text,
                highlight: nodeData.attrs && nodeData.attrs['data-highlight']
            });
        }

    </script>

}