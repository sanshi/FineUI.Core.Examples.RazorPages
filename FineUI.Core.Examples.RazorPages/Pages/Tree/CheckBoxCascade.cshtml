@page
@model FineUI.Core.Examples.RazorPages.Pages.Tree.CheckBoxCascadeModel
@{
    ViewBag.Title = "Tree/CheckBoxCascade";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableCheckBox="true" CascadeCheck="true">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" NodeID="suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" NodeID="xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                    </f:TreeNode>
                    <f:TreeNode Text="黄山市" NodeID="huangshan">
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>

    <f:Button ID="btnGetCheckedValues" Text="获取选中的复选框" OnClick="@Url.Handler("btnGetCheckedValues_Click")" OnClickParameter1="@(Parameter.FromFunction("checkedNodes", "getCurrentControlCheckedNodesPostbackValue"))"></f:Button>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlCheckedNodesPostbackValue() {
            return getCheckedNodes();
        }

    </script>


    <script>
        function getCheckedNodes() {
            var result = [];

            var checkedNodes = F.ui.Tree1.getCheckedNodes(true);
            if (checkedNodes.length) {
                $.each(checkedNodes, function (index, node) {
                    result.push({
                        id: node.id,
                        text: node.text
                    });
                });
            }

            return F.toJSON(result);
        }
    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示父子节点级联勾选，并切换为各节点独立勾选。</p>
    <h3><i class="f-iconfont f-iconfont-check-box" aria-hidden="true"></i>核对级联勾选</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>勾选或取消<code>河南省</code>。<br />结果：启用级联时，可勾选子孙节点跟随父节点，父节点状态也随子节点变化。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CascadeCheck</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：启用父子级联勾选，不等同于节点的文字高亮选择。 本页使用<code>true</code>。</li>
    </ul>
</section>
}
