@page
@model FineUI.Core.Examples.RazorPages.Pages.Tree.DataBindDocumentCustomModel
@{
    ViewBag.SourceFiles = "~/wwwroot/content/tree/website.xml";
    ViewBag.Title = "Tree/DataBindDocumentCustom";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件（点击树节点回发）" Nodes="@(TreeNode[])ViewBag.Tree1Nodes"
            OnNodeClick="@Url.Handler("Tree1_NodeClick")" OnNodeClickParameter1="@(new Parameter("nodeInfo", "getNodeInfo(arguments[1])"))">
    </f:Tree>

    <f:Label ID="labResult" EncodeText="false"></f:Label>




    <br>
    <br>
    注：从 XmlDocument 手工创建节点列表，并将 Xml 节点属性 Highlight 转化为树节点的 CssClass 属性。

}


@section script {

    <script>

        function getNodeInfo(nodeId) {
            var nodeData = F.ui.Tree1.getNodeData(nodeId);

            return F.toJSON({
                id: nodeId,
                text: nodeData.text,
                highlight: nodeData.cls === 'highlight'
            });
        }

    </script>

}