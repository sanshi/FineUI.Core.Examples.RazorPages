@page
@model FineUI.Core.Examples.RazorPages.Pages.Grid.HeaderChangePropertiesModel
@{
    ViewBag.Title = "UIHelper修改标题和宽度";
}

@section body {
    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格"
            DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField ColumnID="EntranceYear" HeaderText="入学年份" Width="120" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>
    <br>
    <f:Button ID="Button1" CssClass="marginr" Text="修改[入学年份]的标题文本和宽度" OnClick="@Url.Handler("Button1_Click")" />
    <f:Button ID="Button2" CssClass="marginr" Text="还原[入学年份]" OnClick="@Url.Handler("Button2_Click")" />
    <f:Button ID="Button3" Text="再次回发（保留列设置）" OnClick="@Url.Handler("Button3_Click")" />
    <br>
    <br>
    <f:Label ID="LabelResult" Text="修改后可再次回发，观察列设置和已有数据。" />


}

@section script {
    <script src="~/res/js/grid.js"></script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>让过长列标题自动换行，显示超过单行宽度的文字。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看长标题的换行方式</h3>
    <ol>
        <li>缩窄<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的专业列或所在区域。<br />结果：专业列长标题按宽度折行，标题行高随实际文字调整。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>后台用 UIHelper.RenderField 指定表格 ID 和 ColumnID，再调用 HeaderText 和 Width 更新标题文本与列宽。</p>
    <p>可先勾选几行再修改或还原；再次回发只更新提示文字，保留浏览器中的列设置、行数据及选择。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CSS</code>（<strong>专业列标题文字</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：标题文字使用允许换行的样式，作用范围限定在长标题列。</li>
    </ul>
</section>
}
