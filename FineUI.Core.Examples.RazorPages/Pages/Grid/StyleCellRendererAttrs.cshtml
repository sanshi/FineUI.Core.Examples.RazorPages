@page
@model FineUI.Core.Examples.RazorPages.Pages.Grid.StyleCellRendererAttrsModel
@{
    ViewBag.Title = "Grid/StyleCellRendererAttrs";
    var F = Html.F();
}


@section head {

    <style>

        .f-grid-cell[data-color=color1] {
            color: red;
            font-weight: bold;
        }

        .f-grid-cell[data-color=color3] {
            color: green;
            font-weight: bold;
        }

    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" RendererFunction="renderEntranceYear" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <Attributes>
            <f:Attribute Key="data-source-key" Value="source1"></f:Attribute>
        </Attributes>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button Text="重新绑定表格" OnClick="@Url.Handler("Button1_Click")" OnClickParameter1="@(new Parameter("fields", "F.ui.Grid1.fields"))" OnClickParameter2="@(new Parameter("source", "F.ui.Grid1.getAttr('data-source-key')"))"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 文本 - 入学年份
        function renderEntranceYear(value, params) {
            if (value >= 2000 && value <= 2004) {
                params.cellAttrs['data-color'] = 'color3';
            }

            return value;
        }

        // 文本 - 性别
        function renderGender(value, params) {
            if (value == 1) {
                params.cellAttrs['data-color'] = 'color1';
            }

            return value == 1 ? '男' : '女';
        }

    </script>
}
