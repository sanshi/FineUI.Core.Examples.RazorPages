@page
@model FineUI.Core.Examples.RazorPages.Pages.Grid.GroupFieldHiddenModel
@{
    ViewBag.Title = "Grid/GroupFieldHidden";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataSource="@ViewBag.Grid1DataSource">
        <Columns>
            <f:RenderField DataField="Year" HeaderText="统计年份" />
            <f:GroupField ColumnID="anhui" HeaderText="安徽省" TextAlign="Center">
                <Columns>
                    <f:GroupField HeaderText="合肥市" TextAlign="Center">
                        <Columns>
                            <f:RenderField DataField="AHData1" HeaderText="数据一" />
                            <f:RenderField DataField="AHData2" HeaderText="数据二" />
                        </Columns>
                    </f:GroupField>
                </Columns>
            </f:GroupField>
            <f:GroupField HeaderText="河南省" TextAlign="Center">
                <Columns>
                    <f:GroupField ColumnID="zhumadian" HeaderText="驻马店市" TextAlign="Center" Hidden="true">
                        <Columns>
                            <f:RenderField DataField="HZData1" HeaderText="数据一" />
                            <f:RenderField DataField="HZData2" HeaderText="数据二" />
                        </Columns>
                    </f:GroupField>
                    <f:GroupField HeaderText="漯河市" TextAlign="Center">
                        <Columns>
                            <f:RenderField DataField="HLData1" HeaderText="数据一" />
                            <f:RenderField DataField="HLData2" HeaderText="数据二" />
                        </Columns>
                    </f:GroupField>
                </Columns>
            </f:GroupField>
            <f:RenderField BoxFlex="1" TextAlign="Center" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" HeaderText="记录时间" />
        </Columns>
    </f:Grid>
    <br>
    <br>
    <f:Button ID="Button3" Text="显示/隐藏[安徽省]列" CssClass="marginr" OnClick="@Url.Handler("Button3_Click")" OnClickParameter1="@(new Parameter("anhuiHidden", "F.ui.Grid1.getColumn('anhui').hidden"))"></f:Button>

    <f:Button ID="Button1" Text="显示/隐藏[河南省/驻马店市]列" CssClass="marginr" OnClick="@Url.Handler("Button1_Click")" OnClickParameter1="@(new Parameter("zhumadianHidden", "F.ui.Grid1.getColumn('zhumadian').hidden"))"></f:Button>
    <br>
    <br>
    注：初始隐藏[河南省]下面的[驻马店]。

}
