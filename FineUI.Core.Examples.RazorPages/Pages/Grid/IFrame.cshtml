@page
@model FineUI.Core.Examples.RazorPages.Pages.Grid.IFrameModel
@{
    ViewBag.SourceFiles = "~/Grid/IFrameWindow";
    ViewBag.Title = "Grid/IFrame";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="窗口列" RendererFunction="renderWindowField1"></f:RenderField>
            <f:RenderField HeaderText="窗口列" RendererFunction="renderWindowField2"></f:RenderField>
            <f:RenderField HeaderText="窗口列" RendererFunction="renderWindowField3"></f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="rowdblclick" Handler="onGridRowDblClick"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <br>


    <f:Window ID="Window1" Title="编辑" Hidden="true" EnableIFrame="true" CloseAction="HidePostBack" EnableMaximize="true" EnableResize="true"
              OnClose="@Url.Handler("Window1_Close")" Target="Top" IsModal="true" Width="850" Height="500">
    </f:Window>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

    function renderWindowField1(value, params) {
        return '<a href="#" class="mywindowfield">编辑</a>';
    }

    function renderWindowField2(value, params) {
        return '<a href="#" class="mywindowfield"><i class="f-icon f-icon-edit f-grid-cell-iconfont"></i></a>';
    }

    function renderWindowField3(value, params) {
        return '<a href="#" class="mywindowfield"><img class="f-grid-cell-icon" src="@Url.Content("~/res/icon/pencil.png")"></a>';
    }

    // 打开窗体
    function openWindow(rowData) {

        // /Grid/IFrameWindow?id=104&name=刘国
        var iframeWindowUrl = '@Url.Content("~/Grid/IFrameWindow")';
        var iframeUrl = iframeWindowUrl + '?id=' + rowData.id + '&name=' + encodeURIComponent(rowData.text);

        // 显示窗体
        F.ui.Window1.show(iframeUrl, '编辑 - ' + rowData.text);
    }

    // 双击行
    function onGridRowDblClick(event, rowId) {
        openWindow(F.ui.Grid1.getRowData(rowId));
    }



    F.ready(function () {

        var grid = F.ui.Grid1;

        // 点击表格行中的编辑按钮
        grid.el.on('click', 'a.mywindowfield', function (event) {
            event.preventDefault();
            var rowEl = $(this).closest('.f-grid-row');
            var rowData = grid.getRowData(rowEl);

            openWindow(rowData);
        });

    });


    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>点击行内入口，把这一行的资料传给独立审批窗体。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>由表格记录打开审批窗体</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>某行的铅笔入口。<br />结果：脚本用入口所属行生成网址参数和窗体标题，IFrame 内显示相应资料；<strong>姓名</strong>通过编码传入，不能直接拼接未编码文字。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：双击行同样可以弹出编辑窗体。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Window1" title="编辑">编辑</strong>）：初始为 <code>true</code>，在独立页面中呈现选中记录资料。</li>
        <li><code>getSelectedRows / show</code>（<strong>打开窗体的页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：从当前记录或选择集合取得稳定主键与显示文字，作为窗体地址及标题；本页不执行真实审批业务。</li>
    </ul>
</section>
}
