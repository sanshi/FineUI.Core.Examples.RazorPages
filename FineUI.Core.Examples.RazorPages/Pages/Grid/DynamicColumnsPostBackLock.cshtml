@page
@model FineUI.Core.Examples.RazorPages.Pages.Grid.DynamicColumnsPostBackLockModel
@{
    ViewBag.Title = "Grid/DynamicColumnsPostBackLock";
    var F = Html.F();
}

@section body {

    <f:DropDownList ID="DropDownList1" Label="切换表格" Width="500"
                    OnSelectedIndexChanged="@Url.Handler("DropDownList1_SelectedIndexChanged")" OnSelectedIndexChangedParameter1="@(Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue"))">
        <Items>
            <f:ListItem Text="表格一（单选，列锁定）" Value="table1" Selected="true"></f:ListItem>
            <f:ListItem Text="表格二（多选，列锁定）" Value="table2"></f:ListItem>
        </Items>
    </f:DropDownList>
    <br>
    <br>
    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格一（单选，列锁定）" DataIDField="Id" DataTextField="Name" EnableMultiSelect="false"
            DataSource="@DataSourceUtil.GetDataTable()" Columns="@ViewBag.Grid1Columns" AllowColumnLocking="true">
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br>
    <br>
}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedPostbackValue() {
            return this.getValue();
        }

    </script>


    <script src="~/res/js/grid.js"></script>

}
