@page
@model FineUI.Core.Examples.RazorPages.Pages.Grid.IFrameMultiModel
@{
    ViewBag.SourceFiles = "~/Grid/IFrameWindow";
    ViewBag.Title = "Grid/IFrameMulti";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableMultiSelect="true" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="窗口列" RendererFunction="renderWindowField1"></f:RenderField>
        </Columns>
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="btnApprove" Text="审批数据" Icon="ApplicationEdit" ClickHandler="onApproveClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>

    <br>
    <br>
    注：选择多行数据，然后点击[审批数据]按钮。

    <f:Window ID="Window1" Title="编辑" Hidden="true" EnableIFrame="true" CloseAction="HidePostBack" EnableMaximize="true" EnableResize="true"
              OnClose="@Url.Handler("Window1_Close")" Target="Self" IsModal="true" Width="850" Height="500">
    </f:Window>
}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

    function renderWindowField1(value, params) {
        return '<a href="#" class="mywindowfield">编辑</a>';
    }

    // 打开窗体
    function openWindow(ids, texts) {

        // /Grid/IFrameWindow?id=104&name=刘国
        var iframeWindowUrl = '@Url.Content("~/Grid/IFrameWindow")';
        var iframeUrl = iframeWindowUrl + '?id=' + ids + '&name=' + encodeURIComponent(texts);

        // 显示窗体
        F.ui.Window1.show(iframeUrl, '详细信息 - ' + texts);
    }


    function onApproveClick(event) {
        var grid = F.ui.Grid1;

        if (!grid.hasSelection()) {
            F.alert('请至少选择一项！');
            return;
        }

        var selectedRows = grid.getSelectedRows(true);

        // DataIDField
        var selectedRowIds = $.map(selectedRows, function (item, index) {
            return item.id;
        }).join(',');

        // DataTextField
        var selectedRowTexts = $.map(selectedRows, function (item, index) {
            return item.text;
        }).join(',');

        openWindow(selectedRowIds, selectedRowTexts);
    }


    F.ready(function () {

        var grid = F.ui.Grid1;

        // 点击表格行中的编辑按钮
        grid.el.on('click', 'a.mywindowfield', function (event) {
            event.preventDefault();
            var rowEl = $(this).closest('.f-grid-row');
            var rowData = grid.getRowData(rowEl);

            openWindow(rowData.id, rowData.text);
        });

    });


    </script>
}
