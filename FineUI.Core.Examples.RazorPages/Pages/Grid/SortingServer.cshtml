@page
@model FineUI.Core.Examples.RazorPages.Pages.Grid.SortingServerModel
@{
    ViewBag.Title = "Grid/SortingServer";
    var F = Html.F();
}



@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name" AllowSorting="true" OnSort="@Url.Handler("Grid1_Sort")" OnSortFields="Grid1" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button CssClass="marginr" Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <f:Button ID="btnSortEntranceYearDescending" Text="[入学年份]倒序排列" OnClick="@Url.Handler("btnSortEntranceYearDescending_Click")" OnClickParameter1="@(Parameter.FromFunction("fields", "getGrid1FieldsPostbackValue"))"></f:Button>

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getGrid1FieldsPostbackValue() {
            return F.ui.Grid1.fields;
        }

    </script>


    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>由按钮在后台指定排序列与方向，使数据顺序与表头标记同步更新。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>通过按钮指定排序</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnSortEntranceYearDescending" title="[入学年份]倒序排列">[入学年份]倒序排列</strong>。<br />结果：后台把<strong>入学年份</strong>设为降序条件，重新绑定后较大的年份排在前面，列标题显示降序标记。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>SortField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：指定排序使用的数据字段；未设置时初次加载不主动排序。</li>
        <li><code>SortDirection</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：指定排序方向 ASC 或 DESC，并与重新绑定后的记录保持一致。</li>
    </ul>
</section>
}
