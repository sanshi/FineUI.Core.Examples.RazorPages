@page
@model FineUI.Core.Examples.RazorPages.Pages.GridDataUrl.RowDoubleClickModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/RowDoubleClick";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
        <Listeners>
            <f:Listener Event="rowdblclick" Handler="onGrid1RowDblClick"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDblClick(event, rowId, rowIndex) {
            var grid1 = this;
            var rowData = grid1.getRowData(rowId);
            var rowEl = grid1.getRowEl(rowId);

            // 触发后台事件
            F.doPostBack({
                url: '@Url.Handler("Grid1_RowDblClick")',
                params: {
                    rowIndex: rowEl.index(),
                    rowId: rowData.id,
                    rowText: rowData.text
                }
            });

        }
    </script>
}