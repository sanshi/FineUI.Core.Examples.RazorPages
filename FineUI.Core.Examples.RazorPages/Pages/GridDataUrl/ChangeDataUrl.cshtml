@page
@model FineUI.Core.Examples.RazorPages.Pages.GridDataUrl.ChangeDataUrlModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/ChangeDataUrl";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
        <Attributes>
            <f:Attribute Key="data-source-key" Value="source1"></f:Attribute>
        </Attributes>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="Button1" Text="切换网址数据源" CssClass="marginr" ClickHandler="onButton1Click"></f:Button>
    <f:Button ID="btnReload" Text="重新加载当前网址数据源" CssClass="marginr" OnClick="@Url.Handler("btnReload_Click")"></f:Button>

    <f:Button ID="Button2" Text="切换网址数据源（服务器端）" CssClass="marginr" OnClick="@Url.Handler("Button2_Click")" OnClickParameter1="@(Parameter.FromFunction("Grid1_sourceKey", "getGrid1Grid1_sourceKeyPostbackValue"))">
    </f:Button>



}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getGrid1Grid1_sourceKeyPostbackValue() {
            return F.ui.Grid1.getAttr('data-source-key');
        }

    </script>


    <script src="~/res/js/grid.js"></script>

    <script>

        function onButton1Click(event) {
            var grid1 = F.ui.Grid1;

            if (grid1.getAttr('data-source-key') === 'source1') {
                grid1.setAttr('data-source-key', 'source2')
                grid1.loadDataUrl('@Url.Content("~/GridDataUrl/GridDataUrlData?data2=true")');
            } else {
                grid1.setAttr('data-source-key', 'source1')
                grid1.loadDataUrl('@Url.Content("~/GridDataUrl/GridDataUrlData")');
            }
        }

        function reloadCurrentDataUrl() {
            F.ui.Grid1.loadDataUrl();
        }

    </script>
}
