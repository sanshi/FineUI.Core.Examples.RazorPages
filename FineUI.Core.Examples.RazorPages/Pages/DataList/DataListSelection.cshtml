@page
@model FineUI.Core.Examples.RazorPages.Pages.DataList.DataListSelectionModel
@{
    ViewBag.Title = "数据列表的选择与清空";
}

@section body {
    <f:Panel ID="Panel1" IsFluid="true" MaxWidth="1000" Layout="Block" BlockConfigSpace="20" MarginBottom="20"
        ShowHeader="false" ShowBorder="false">
        <Items>
            <f:Panel ID="PanelSingle" Block="12" BlockMD="4" Title="单选" BodyPadding="10">
                <Items>
                    <f:DataList ID="DataListSingle" EnableSelect="true" SelectedValue="beijing">
                        <Items>
                            <f:DataListItem Value="beijing" Text="北京" />
                            <f:DataListItem Value="shanghai" Text="上海" />
                            <f:DataListItem Value="guangzhou" Text="广州" />
                        </Items>
                    </f:DataList>
                </Items>
            </f:Panel>
            <f:Panel ID="PanelMulti" Block="12" BlockMD="4" Title="多选" BodyPadding="10">
                <Items>
                    <f:DataList ID="DataListMulti" EnableSelect="true" EnableMultiSelect="true" _SelectedValueArray="beijing,shanghai">
                        <Items>
                            <f:DataListItem Value="beijing" Text="北京" />
                            <f:DataListItem Value="shanghai" Text="上海" />
                            <f:DataListItem Value="guangzhou" Text="广州" />
                        </Items>
                    </f:DataList>
                </Items>
            </f:Panel>
            <f:Panel ID="PanelKeep" Block="12" BlockMD="4" Title="多选，保持当前选择" BodyPadding="10">
                <Items>
                    <f:DataList ID="DataListKeep" EnableSelect="true" EnableMultiSelect="true"
                        KeepCurrentSelection="true" _SelectedValueArray="beijing,shanghai">
                        <Items>
                            <f:DataListItem Value="beijing" Text="北京" />
                            <f:DataListItem Value="shanghai" Text="上海" />
                            <f:DataListItem Value="guangzhou" Text="广州" />
                        </Items>
                    </f:DataList>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <f:Button ID="btnRead" Text="读取选择" CssClass="marginr" OnClick="@Url.Handler("btnRead_Click")"
        OnClickParameter1="@(Parameter.FromFunction("single", "getSingleSelection"))"
        OnClickParameter2="@(Parameter.FromFunction("multi", "getMultiSelection"))"
        OnClickParameter3="@(Parameter.FromFunction("keep", "getKeepSelection"))" />
    <f:Button ID="btnAssign" Text="后台赋值" CssClass="marginr" OnClick="@Url.Handler("btnAssign_Click")" />
    <f:Button ID="btnClear" Text="清空选择" OnClick="@Url.Handler("btnClear_Click")" />
    <br />
    <br />
    <f:Label ID="labResult" Text="请修改选择，再点击“读取选择”。" />
    <p>普通多选按 Ctrl 累积选择；开启 KeepCurrentSelection 后，普通点击即可切换当前项，其他选择保留。</p>
    <p>清空选择保留列表数据。后台赋值与清空通过 UIHelper 更新浏览器，再次读取时提交浏览器当前的选择。</p>
}

@section script {
    <script>
        // 原生提交只传当前选择值，后台读取本次参数，不依赖页面控件状态。
        function getSingleSelection() {
            return F.ui.DataListSingle.getSelectedItems();
        }

        function getMultiSelection() {
            return F.ui.DataListMulti.getSelectedItems();
        }

        function getKeepSelection() {
            return F.ui.DataListKeep.getSelectedItems();
        }
    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示数据列表的单选、多选和保留选择，并由后台统一读取、赋值或清空选择。</p>
    <h3><i class="f-iconfont f-iconfont-check" aria-hidden="true"></i>比较三种选择规则</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="DataListSingle" title="第 1 个数据列表">第 1 个数据列表</strong>依次点击两个城市，再在其它两组列表连续点击城市。<br />结果：单选只保留一个项目；多选按点击及按键规则更新，保持选择的一组可连续累加。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableSelect</code>（<strong class="example-control-reference" data-example-control="DataListSingle" title="第 1 个数据列表">第 1 个数据列表</strong>、<strong class="example-control-reference" data-example-control="DataListMulti" title="第 2 个数据列表">第 2 个数据列表</strong>、<strong class="example-control-reference" data-example-control="DataListKeep" title="第 3 个数据列表">第 3 个数据列表</strong>）：开启列表项目选择。 本页使用<code>true</code>。</li>
        <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DataListMulti" title="第 2 个数据列表">第 2 个数据列表</strong>、<strong class="example-control-reference" data-example-control="DataListKeep" title="第 3 个数据列表">第 3 个数据列表</strong>）：为本页对应列表开启多选。 本页使用<code>true</code>。</li>
        <li><code>KeepCurrentSelection</code>（<strong class="example-control-reference" data-example-control="DataListKeep" title="第 3 个数据列表">第 3 个数据列表</strong>）：保持选择的一组开启此属性，连续点击不清除之前的项目。 本页使用<code>true</code>。</li>
        <li><code>_SelectedValueArray</code>（<strong class="example-control-reference" data-example-control="DataListMulti" title="第 2 个数据列表">第 2 个数据列表</strong>、<strong class="example-control-reference" data-example-control="DataListKeep" title="第 3 个数据列表">第 3 个数据列表</strong>）：保存多选列表的稳定项值集合。 本页使用<code>beijing,shanghai</code>。</li>
    </ul>
</section>
}
