@page
@model FineUI.Core.Examples.RazorPages.Pages.DataList.DataListDataBindModel
@{
    ViewBag.Title = "数据列表的数据绑定";
}

@section body {
    <f:Panel ID="Panel1" IsFluid="true" MaxWidth="650" Title="数据绑定" BodyPadding="10">
        <Items>
            <f:DataList ID="DataList1" Items="@Model.DataListItems" />
        </Items>
    </f:Panel>
    <br />
    <f:Button ID="btnReload" Text="重新加载" CssClass="marginr" OnClick="@Url.Handler("btnReload_Click")" />
    <f:Button ID="btnAppend" Text="追加数据" OnClick="@Url.Handler("btnAppend_Click")"
        OnClickParameter1="@(Parameter.FromFunction("appendCount", "getAppendCount"))" />
    <f:HiddenField ID="hfAppendCount" Text="0" />
    <br />
    <br />
    <f:Label ID="labResult" Text="已加载 3 项。" />
    <p>首次在后台绑定城市数据；重新加载会反转初始三项的顺序，并重置追加批次。</p>
    <p>每次追加深圳和杭州两项，值包含批次编号，连续追加时已有数据保留且项值不重复。</p>
}

@section script {
    <script>
        function getAppendCount() {
            return F.ui.hfAppendCount.getValue();
        }
    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示把对象数据绑定为列表，重新加载时替换项目，追加时保留已有项目。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>区分重新加载与追加</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnReload" title="重新加载">重新加载</strong>。<br />结果：用重新准备的三项数据替换列表，并把数量与追加批次重置。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataTextField</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：使用 <code>Name</code> 字段作为显示文字。</li>
        <li><code>DataValueField</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：使用 <code>Id</code> 字段作为稳定的项目值。</li>
        <li><code>LoadData()</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：替换当前项目集合。</li>
        <li><code>AppendData()</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：在末尾追加项目，不清除已有列表。</li>
    </ul>
</section>
}
