@page
@model FineUI.Core.Examples.RazorPages.Pages.DataList.DataListGroupModel
@{
    ViewBag.Title = "数据列表的分组与模板";
}

@section body {
    <f:Panel ID="Panel1" IsFluid="true" MaxWidth="650" Title="分组与模板" BodyPadding="10">
        <Items>
            <f:DataList ID="DataList1" EnableGroup="true" EnableSelect="true">
                <Listeners>
                    <f:Listener Event="itemclick" Handler="onDataListItemClick" />
                </Listeners>
                <Items>
                    <f:DataListItem Value="beijing" Group="华北" NavigateUrl="#details" ShowArrow="true"
                        TextRawHtml="@(new RawHtml("<strong>北京</strong><br />首都"))" />
                    <f:DataListItem Value="tianjin" Group="华北" NavigateUrl="#details" ShowArrow="true"
                        TextRawHtml="@(new RawHtml("<strong>天津</strong><br />海河之城"))" />
                    <f:DataListItem Value="shanghai" Group="华东" NavigateUrl="#details" ShowArrow="true"
                        TextRawHtml="@(new RawHtml("<strong>上海</strong><br />国际都市"))" />
                    <f:DataListItem Value="hangzhou" Group="华东" NavigateUrl="#details" ShowArrow="true"
                        TextRawHtml="@(new RawHtml("<strong>杭州</strong><br />西湖之城"))" />
                </Items>
            </f:DataList>
        </Items>
    </f:Panel>
    <br />
    <f:Label ID="labResult" Text="点击城市查看项值。" />
    <p>按 Group 将相邻城市分组；可信 HTML 模板显示标题与说明，ShowArrow 显示链接箭头。</p>
    <p>点击项由具名客户端函数处理，显示稳定的项值，不进行移动面板切换。动态模板内容必须先编码。</p>
}

@section script {
    <script>
        function onDataListItemClick(event, itemValue) {
            event.preventDefault();
            F.ui.labResult.setValue('点击项：' + itemValue);
        }
    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示数据列表按区域分组，使用固定 HTML 模板展示标题和说明，并处理项目点击。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>从分组项目读取编号</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>点击<code>北京</code>，再点击<code>上海</code>。<br />结果：列表保留华北、华东分组，结果标签显示当前项目的稳定编号；本页阻止链接默认跳转，不切换移动面板。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableGroup</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：开启列表分组。 本页使用<code>true</code>。</li>
        <li><code>Group</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：指定项目所属的区域分组。</li>
        <li><code>Text</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：本页使用固定可信 HTML 提供标题和业务说明；外部输入应先编码。</li>
        <li><code>itemclick</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：读取当前项值并更新结果，同时阻止默认导航。</li>
    </ul>
</section>
}
