@page
@model FineUI.Core.Examples.RazorPages.Pages.GridTree.CheckBoxModel
@{
    ViewBag.Title = "GridTree/CheckBox";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name"
        DataSource="@DataSourceUtil.GetTreeDataTable()" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId" TreeCheckBox="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button CssClass="marginr" Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


    <f:Button ID="btnGetCheckedValues" Text="获取选中的复选框" OnClick="@Url.Handler("btnGetCheckedValues_Click")" OnClickParameter1="@(Parameter.FromFunction("checkedRows", "getCurrentControlCheckedRowsPostbackValue"))"></f:Button>
    <br>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>
}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlCheckedRowsPostbackValue() {
            return getCheckedRows();
        }

    </script>


    <script src="~/res/js/grid.js"></script>

    <script>
        function getCheckedRows() {
            var result = [];

            var checkedRows = F.ui.Grid1.getCheckedRows(true);
            if (checkedRows.length) {
                $.each(checkedRows, function (index, row) {
                    result.push({
                        id: row.id,
                        text: row.text
                    });
                });
            }

            return F.toJSON(result);
        }
    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在名称列显示树复选框，按节点读取勾选结果，与整行选择分别处理。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>勾选节点并读取结果</h3>
        <ol>
            <li>展开<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>的 basic、res
                等目录，尝试切换<strong>名称</strong>旁的树复选框。<br />结果：树节点自身勾选改变，单独点击行仍是另一套行选择，不会自动把所有后代一起勾选。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnGetCheckedValues"
                    title="获取选中的复选框">获取选中的复选框</strong>。<br />结果：客户端读取已勾选树节点并交给后台，在结果区域显示标识与<strong>名称</strong>；没有勾选时显示对应提示。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>TreeCheckBox</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>true</code>，在树列节点旁显示专用复选框。
            </li>
            <li><code>getCheckedRows</code>（<strong>读取勾选的页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>）：读取树复选框结果，不使用 getSelectedRows 代替节点勾选。</li>
        </ul>
    </section>
}
