@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.NumberBoxTextChangedModel
@{
    ViewBag.Title = "Form/NumberBoxTextChanged";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false"
                  Title="简单表单" LabelWidth="120">
        <Items>
            <f:NumberBox Label="非负整数" ID="NumberBox3" EmptyText="比如 99" NoDecimal="true" NoNegative="true" Required="true" ShowRedStar="true" OnTextChanged="@Url.Handler("NumberBox3_TextChanged")" OnTextChangedParameter1="@(Parameter.FromFunction("text", "getNumberBox3TextPostbackValue"))" />
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="@Url.Handler("btnSubmit_Click")" OnClickParameter1="@(Parameter.FromFunction("text", "getNumberBox3TextPostbackValue"))"></f:Button>
        </Items>
    </f:SimpleForm>




}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getNumberBox3TextPostbackValue() {
            return F.ui.NumberBox3.getValue();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示手工输入或使用增减箭头后，通过数值变化事件读取最新值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-sort" aria-hidden="true"></i>增减并读取数值</h3>
        <ol>
            <li>
                在<strong class="example-control-reference" data-example-control="NumberBox3" title="非负整数">非负整数</strong>中输入 <code>28</code>，按键盘向下方向键。<br />
                结果：回发后，后台显示当前值 <code>27</code>，输入框也变为 <code>27</code>。
            </li>
            <li>
                点击向上的增减图标。<br />
                结果：回发后，后台显示当前值 <code>28</code>。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：手工输入数字，或者点击右侧上下箭头都会触发文本改变事件。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnTextChanged</code>（<strong class="example-control-reference" data-example-control="NumberBox3" title="非负整数">非负整数</strong>）：变化事件回发后，后台读取最新值。</li>
        </ul>
    </section>
}
