@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.RadioButtonListTooltipModel
@{
    ViewBag.Title = "Form/RadioButtonListTooltip";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="160" EnableCollapse="false" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:RadioButtonList ID="RadioButtonList1" Label="列表一">
                <f:RadioItem Text="可选项 1" Value="value1" />
                <f:RadioItem Text="可选项 2" Value="value2" />
                <f:RadioItem Text="可选项 3" Value="value3" />
            </f:RadioButtonList>
            <f:RadioButtonList ID="RadioButtonList2" Label="列表二（一列）" ColumnNumber="1" DataTextField="Name" DataValueField="Id"
                               DataSource="@ViewBag.RadioButtonList2DataSource" SelectedValue="@ViewBag.RadioButtonList2SelectedValue">
            </f:RadioButtonList>
        </Items>
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="@Url.Handler("btnSubmit_Click")" OnClickFields="SimpleForm1"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>


    <br />
    <br />
    注：在页面视图上，通过遍历数据源来更新下拉列表每一项的属性。

    @{
        RadioButtonList RadioButtonList1 = F.GetControl<RadioButtonList>("RadioButtonList1");
        // 手工设置复选框列表项的提示信息
        RadioButtonList1.Items[0].Attributes["data-qtip"] = "这是第一个选项的提示信息";
        RadioButtonList1.Items[1].Attributes["data-qtip"] = "这是第二个选项的提示信息";
        RadioButtonList1.Items[2].Attributes["data-qtip"] = "这是第三个选项的提示信息";




        RadioButtonList RadioButtonList2 = F.GetControl<RadioButtonList>("RadioButtonList2");

        // 视图中设置控件的DataSource属性，会延迟到页面渲染时才调用DataBind函数。如果需要在视图中访问Items属性，需要手工调用DataBind函数。
        RadioButtonList2.DataBind();

        foreach (var item in RadioButtonList2.Items)
        {
            item.Attributes["data-qtip"] = String.Format("{0}（值：{1}）", item.Text, item.Value);
        }

        // // 方法二：直接读取数据源
        // var index = 0;
        // foreach (var dataItem in RadioButtonList2.DataSource as List<RadioButtonListTooltipModel.TestClass>)
        // {
        //     RadioButtonList2.Items[index].Attributes["data-qtip"] = String.Format("{0}（值：{1}）", dataItem.Name, dataItem.Id);
        //     index++;
        // }

    }

}

