@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.FormValidateBlurModel
@{
    ViewBag.Title = "Form/FormValidateBlur";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="用户注册表单">
        <Items>
            <f:TextBox ID="tbxUserName" Label="用户名" Required="true" NextFocusControl="tbxPassword" ShowRedStar="true" Text="admin" OnBlur="@Url.Handler("tbxUserName_Blur")" OnBlurParameter1="@(Parameter.FromFunction("userName", "gettbxUserNameUserNamePostbackValue"))">
            </f:TextBox>
            <f:TextBox ID="tbxPassword" Label="密码" Required="true" ShowRedStar="true" NextClickControl="btnRegister" TextMode="Password">
            </f:TextBox>
            <f:Button ID="btnRegister" Text="注册" _ValidateForms="SimpleForm1" ValidateTarget="Top" OnClick="@Url.Handler("btnRegister_Click")" OnClickFields="SimpleForm1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>
    <br>
    注：
    <ul>
        <li>
            [用户名]失去焦点，如果为 admin，则标记为无效；否则去除无效标记
        </li>
        <li>
            [用户名]按下 Enter 键，如果为 admin，则标记为无效；否则去除无效标记，并跳转到[密码]
        </li>
        <li>
            [密码]按下 Enter 键，提交表单
        </li>
    </ul>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function gettbxUserNameUserNamePostbackValue() {
            return F.ui.tbxUserName.getValue();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示离开用户名输入框时立即进行后台校验，并在修正错误后聚焦密码框。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>离开字段时校验，再提交</h3>
        <ol>
            <li>
                先点击用户名输入框，保持为“admin”，再点击密码框。<br />
                结果：用户名失去焦点后回发，后台将用户名标为无效，提示 admin 是保留字。
            </li>
            <li>
                回到用户名框，改为“demo”，再点击页面空白处。<br />
                结果：再次回发校验，后台清除用户名错误，并将焦点移到密码框。
            </li>
            <li>
                密码输入“123456”，点击“注册”或在密码框按 Enter。<br />
                结果：先检查必填项，回发后再次校验用户名，通过后显示表单字段值；本例没有实际创建账号。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnBlur</code>：绑定 tbxUserName_Blur，在用户名失去焦点时回发校验。</li>
            <li><code>MarkInvalid()</code>：将 admin 的保留字错误标记到用户名框。</li>
            <li><code>ClearInvalid()</code>：用户名有效时清除之前的错误。</li>
            <li><code>Focus()</code>：后台校验通过后，让浏览器聚焦密码框。</li>
            <li><code>_ValidateForms</code>：注册前检查整个表单的必填项；后台注册事件仍会再次检查用户名。</li>
        </ul>
    </section>
}
