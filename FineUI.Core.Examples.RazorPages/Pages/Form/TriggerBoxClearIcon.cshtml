@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.TriggerBoxClearIconModel
@{
    ViewBag.Title = "Form/TriggerBoxClearIcon";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="表单" ShowHeader="true">
        <Items>
            <f:TriggerBox ID="TriggerBox1" ShowLabel="false" Text="默认值"
                          TriggerIcon="Clear" ShowTrigger="false" AutoShowClearIcon="true">
            </f:TriggerBox>
            <f:Button ID="btnSubmit" Text="提交表单" OnClick="@Url.Handler("btnSubmit_Click")" OnClickParameter1="@(Parameter.FromFunction("box1Value", "getTriggerBox1Box1ValuePostbackValue"))"></f:Button>
        </Items>
    </f:SimpleForm>

}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getTriggerBox1Box1ValuePostbackValue() {
            return F.ui.TriggerBox1.getValue();
        }

    </script>
}
