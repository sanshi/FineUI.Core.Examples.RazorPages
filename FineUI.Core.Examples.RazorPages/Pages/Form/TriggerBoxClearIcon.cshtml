@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.TriggerBoxClearIconModel
@{
    ViewBag.Title = "Form/TriggerBoxClearIcon";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="表单" ShowHeader="true">
        <Items>
            <f:TriggerBox ID="TriggerBox1" ShowLabel="false" Text="默认值"
                          TriggerIcon="Clear" ShowTrigger="false" AutoShowClearIcon="true">
            </f:TriggerBox>
            <f:Button ID="btnSubmit" Text="提交表单" OnClick="@Url.Handler("btnSubmit_Click")" OnClickParameter1="@(new Parameter("box1Value", "F.ui.TriggerBox1.getValue()"))"></f:Button>
        </Items>
    </f:SimpleForm>

}

