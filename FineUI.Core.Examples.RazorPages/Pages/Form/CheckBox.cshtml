@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.CheckBoxModel
@{
    ViewBag.Title = "Form/CheckBox";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:CheckBox ID="CheckBox1" ShowLabel="false" Text="复选框" Checked="true">
            </f:CheckBox>
            <f:Button ID="btnSelectCheckBox" CssClass="marginr" Text="选择/反选复选框" OnClick="@Url.Handler("btnSelectCheckBox_Click")"
                OnClickParameter1="@(Parameter.FromFunction("isChecked", "getCheckBox1IsCheckedPostbackValue"))"></f:Button>
            <f:Button ID="btnChangeCheckStatus" CssClass="marginr" Text="选择/反选复选框（客户端脚本）" ClickHandler="onChangeCheckStatusClick"></f:Button>
            <f:Button ID="btnChangeText" Text="改变复选框文本" CssClass="marginr" OnClick="@Url.Handler("btnChangeText_Click")"></f:Button>
            <f:Button ID="btnDisable" CssClass="marginr" Text="启用/禁用复选框" OnClick="@Url.Handler("btnDisableCheckBox_Click")" OnClickParameter1="@(Parameter.FromFunction("isDisabled", "getCheckBox1IsDisabledPostbackValue"))">
            </f:Button>
            <f:Label ID="Label1">
            </f:Label>
            <f:CheckBox ID="CheckBox2" ShowLabel="false" Checked="true" Text="复选框（OnCheckedChanged）" OnCheckedChanged="@Url.Handler("CheckBox2_CheckedChanged")"
                OnCheckedChangedParameter1="@(Parameter.FromFunction("isChecked", "getCheckBox2IsCheckedPostbackValue"))">
            </f:CheckBox>
            <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
            </f:Label>
        </Items>
    </f:SimpleForm>

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCheckBox1IsCheckedPostbackValue() {
            return F.ui.CheckBox1.isChecked();
        }

        function getCheckBox1IsDisabledPostbackValue() {
            return F.ui.CheckBox1.isDisabled();
        }

        function getCheckBox2IsCheckedPostbackValue() {
            return F.ui.CheckBox2.isChecked();
        }

    </script>

    <script>

        function onChangeCheckStatusClick(event) {
            var checkbox = F.ui.CheckBox1;
            checkbox.setValue(!checkbox.getValue());
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>的选中、文字和可用状态修改，并对比客户端操作与后台回发。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check-box" aria-hidden="true"></i>反选、改文字和禁用</h3>
        <ul>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSelectCheckBox" title="选择/反选复选框">选择/反选复选框</strong>。<br />
                结果：回发后由后台反转<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">第一个复选框</strong>的选中状态，再点一次恢复。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnChangeCheckStatus" title="选择/反选复选框（客户端脚本）">选择/反选复选框（客户端脚本）</strong>。<br />
                结果：浏览器直接反选<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">第一个复选框</strong>，无需回发。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnChangeText" title="改变复选框文本">改变复选框文本</strong>。<br />
                结果：回发后由后台将<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">第一个复选框</strong>的文字改为带当前时间的文本。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnDisable" title="启用/禁用复选框">启用/禁用复选框</strong>。<br />
                结果：回发后由后台禁用<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">第一个复选框</strong>，此时无法直接勾选；再点一次恢复可用。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>响应勾选变化</h3>
        <ul>
            <li>
                直接勾选或取消<strong class="example-control-reference" data-example-control="CheckBox2"
                    title="复选框（OnCheckedChanged）">第二个复选框</strong>（<code>OnCheckedChanged</code>）。<br />
                结果：回发提交当前布尔值，后台处理，下方显示“复选框的状态：选中”或“复选框的状态：未选中”。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Checked</code>（<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>）：布尔值表示是否选中，<strong
                    class="example-control-reference" data-example-control="CheckBox1" title="复选框">第一个复选框</strong>初始为选中。</li>
            <li><code>Text</code>（<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>、<strong
                    class="example-control-reference" data-example-control="CheckBox2" title="复选框（OnCheckedChanged）">复选框（OnCheckedChanged）</strong>）：<strong
                    class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>旁的文字，本例可改为带时间的文本。</li>
            <li><code>Disabled</code>（<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>）：后台通过
                <code>UIHelper</code> 设置是否禁用，当前状态作为请求参数提交。
            </li>
            <li><code>OnCheckedChanged</code>（<strong class="example-control-reference" data-example-control="CheckBox2"
                    title="复选框（OnCheckedChanged）">复选框（OnCheckedChanged）</strong>）：<strong class="example-control-reference" data-example-control="CheckBox2"
                    title="复选框（OnCheckedChanged）">第二个复选框</strong>的选中状态改变时回发，后台更新结果标签。</li>
        </ul>
    </section>
}
