@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.CheckBoxModel
@{
    ViewBag.Title = "Form/CheckBox";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:CheckBox ID="CheckBox1" ShowLabel="false" Text="复选框" Checked="true">
            </f:CheckBox>
            <f:Button ID="btnSelectCheckBox" CssClass="marginr" Text="选择/反选复选框" OnClick="@Url.Handler("btnSelectCheckBox_Click")" OnClickParameter1="@(new Parameter("isChecked", "F.ui.CheckBox1.isChecked()"))"></f:Button>
            <f:Button ID="btnChangeCheckStatus" CssClass="marginr" Text="选择/反选复选框（客户端脚本）" ClickHandler="onChangeCheckStatusClick"></f:Button>
            <f:Button ID="btnChangeText" Text="改变复选框文本" CssClass="marginr" OnClick="@Url.Handler("btnChangeText_Click")"></f:Button>
            <f:Button ID="btnDisable" CssClass="marginr" Text="启用/禁用复选框" OnClick="@Url.Handler("btnDisableCheckBox_Click")" OnClickParameter1="@(new Parameter("isDisabled", "F.ui.CheckBox1.isDisabled()"))"></f:Button>
            <f:Label ID="Label1">
            </f:Label>
            <f:CheckBox ID="CheckBox2" ShowLabel="false" Checked="true" Text="复选框（OnCheckedChanged）" OnCheckedChanged="@Url.Handler("CheckBox2_CheckedChanged")" OnCheckedChangedParameter1="@(new Parameter("isChecked", "F.ui.CheckBox2.isChecked()"))">
            </f:CheckBox>
            <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
            </f:Label>
        </Items>
    </f:SimpleForm>

}


@section script {
    <script>

        function onChangeCheckStatusClick(event) {
            var checkbox = F.ui.CheckBox1;
            checkbox.setValue(!checkbox.getValue());
        }

    </script>
}
