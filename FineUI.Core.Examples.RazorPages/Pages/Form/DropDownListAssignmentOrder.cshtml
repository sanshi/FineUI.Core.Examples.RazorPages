@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.DropDownListAssignmentOrderModel
@{
    ViewBag.Title = "下拉列表赋值顺序";
}

@section body {
    <f:SimpleForm ID="SimpleForm1" IsFluid="true" MaxWidth="600" Title="可编辑下拉列表"
        ShowHeader="true" ShowBorder="true" BodyPadding="10" LabelWidth="100">
        <Items>
            <f:DropDownList ID="DropDownList2" Label="当前选择" EnableEdit="true" ForceSelection="false" SelectedValue="a">
                <Items>
                    <f:ListItem Value="a" Text="甲" />
                    <f:ListItem Value="b" Text="乙" />
                </Items>
            </f:DropDownList>
        </Items>
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Bottom">
                <Items>
                    <f:Button ID="btnValueThenText" Text="清空后先赋值再写文字" OnClick="@Url.Handler("btnValueThenText_Click")" CssClass="marginr" />
                    <f:Button ID="btnTextThenValue" Text="清空后先写文字再赋值" OnClick="@Url.Handler("btnTextThenValue_Click")" CssClass="marginr" />
                    <f:Button ID="btnReadDropDownList" OnClickParameter1="@(Parameter.FromFunction("selection", "getDropDownList2Summary"))" Text="读取赋值结果" OnClick="@Url.Handler("btnReadDropDownList_Click")" />
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>
    <br />
    <f:SimpleForm ID="SimpleFormResult" IsFluid="true" MaxWidth="600" Title="后台读取结果"
        ShowHeader="true" ShowBorder="true" BodyPadding="10">
        <Items>
            <f:Label ID="labResult" ShowLabel="false" Text="请先选择一种赋值顺序，再读取赋值结果。" />
        </Items>
    </f:SimpleForm>
    <br />
    <p>可编辑下拉列表清空后，最后写文字表示自由输入，最后选值则显示对应选项。</p>
    <p>先赋值再写文字：选中值为空，文字为“自定义输入”；先写文字再赋值：选中值为 a，文字为“甲”。</p>
    <p>点击“读取赋值结果”，可核对下一次回发时后台收到的选中值和文字。</p>
}

@section script {
    <script>
        // 点击“读取赋值结果”时，把当前选中值和文字一起提交给后台显示。
        function getDropDownList2Summary() {
            var list = F.ui.DropDownList2;
            var value = list.getValue();
            return '选中值：' + (value == null ? '空' : value) + '；文字：' + list.getText();
        }
    </script>
}
