@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.TwinTriggerBoxClearIconModel
@{
    ViewBag.Title = "Form/TwinTriggerBoxClearIcon";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="表单" ShowHeader="true">
        <Items>
            <f:TwinTriggerBox ID="TwinTriggerBox1" ShowLabel="false" Trigger1Icon="Clear" ShowTrigger1="false" EmptyText="搜索用户名" Trigger2Icon="Search" OnTrigger1Click="@Url.Handler("TwinTriggerBox1_Trigger1Click")" OnTrigger2Click="@Url.Handler("TwinTriggerBox1_Trigger2Click")" OnTrigger2ClickParameter1="@(new Parameter("text", "F.ui.TwinTriggerBox1.getValue()"))"
                              AutoShowClearIcon="true">
                <Listeners>
                    <f:Listener Event="change" Handler="onTwinTriggerBox1Change"></f:Listener>
                </Listeners>
            </f:TwinTriggerBox>
        </Items>
    </f:SimpleForm>
    

}

@section script{
    <script>

        // 记录上一次 TwinTriggerBox1 的值
        var __lastTriggerBoxValue;
        var __changeTimer;

        function onTwinTriggerBox1Change(event) {
            if (__changeTimer) {
                window.clearTimeout(__changeTimer);
                __changeTimer = undefined;
            }
            __changeTimer = window.setTimeout(postBackTriggerBoxChange, 1000);
        }

        function postBackTriggerBoxChange() {
            var value = F.ui.TwinTriggerBox1.getValue();
            // 值改变时才回发
            if (value !== __lastTriggerBoxValue) {
                __lastTriggerBoxValue = value;

                // 触发后台事件
                F.doPostBack({
                    url: '@Url.Handler("TwinTriggerBox1_Trigger2Click")',
                    params: {
                        'text': F.ui.TwinTriggerBox1.getValue()
                    }
                });
            }
        }

        function updateLastTriggerBoxValue(text) {
            __lastTriggerBoxValue = text;
        }

        F.ready(function () {
            // 设置 TwinTriggerBox1 初始值
            __lastTriggerBoxValue = F.ui.TwinTriggerBox1.getValue();
        });

    </script>
}

