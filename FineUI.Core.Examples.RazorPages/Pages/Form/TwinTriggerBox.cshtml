@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.TwinTriggerBoxModel
@{
    ViewBag.Title = "Form/TwinTriggerBox";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="表单" ShowHeader="true">
        <Items>
            <f:TwinTriggerBox ID="TwinTriggerBox1" ShowLabel="false" Trigger1Icon="Clear" ShowTrigger1="false" EmptyText="搜索用户名" Trigger2Icon="Search" OnTrigger1Click="@Url.Handler("TwinTriggerBox1_Trigger1Click")" OnTrigger2Click="@Url.Handler("TwinTriggerBox1_Trigger2Click")" OnTrigger2ClickParameter1="@(Parameter.FromFunction("text", "getTwinTriggerBox1TextPostbackValue"))">
            </f:TwinTriggerBox>
        </Items>
    </f:SimpleForm>

}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getTwinTriggerBox1TextPostbackValue() {
            return F.ui.TwinTriggerBox1.getValue();
        }

    </script>
}
