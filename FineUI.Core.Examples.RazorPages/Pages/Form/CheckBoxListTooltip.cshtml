@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.CheckBoxListTooltipModel
@{
    ViewBag.Title = "Form/CheckBoxListTooltip";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="160" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:CheckBoxList ID="CheckBoxList1" Label="列表一">
                <f:CheckItem Text="可选项 1" Value="value1" />
                <f:CheckItem Text="可选项 2" Value="value2" Selected="true" />
                <f:CheckItem Text="可选项 3" Value="value3" Selected="true" />
            </f:CheckBoxList>
            <f:CheckBoxList ID="CheckBoxList2" Label="列表二（一列）" ColumnNumber="1" DataTextField="Name" DataValueField="Id" DataSource="@ViewBag.CheckBoxList2DataSource"
                SelectedValueArray="@ViewBag.CheckBoxList2SelectedValueArray">
            </f:CheckBoxList>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="@Url.Handler("btnSubmit_Click")" OnClickFields="SimpleForm1">
                    </f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>




    @{
        CheckBoxList CheckBoxList1 = F.GetControl<CheckBoxList>("CheckBoxList1");
        // 手工设置复选框列表项的提示信息
        CheckBoxList1.Items[0].Attributes["data-qtip"] = "这是第一个选项的提示信息";
        CheckBoxList1.Items[1].Attributes["data-qtip"] = "这是第二个选项的提示信息";
        CheckBoxList1.Items[2].Attributes["data-qtip"] = "这是第三个选项的提示信息";




        CheckBoxList CheckBoxList2 = F.GetControl<CheckBoxList>("CheckBoxList2");

        // 视图中设置控件的DataSource属性，会延迟到页面渲染时才调用DataBind函数。如果需要在视图中访问Items属性，需要手工调用DataBind函数。
        CheckBoxList2.DataBind();

        foreach (var item in CheckBoxList2.Items)
        {
            item.Attributes["data-qtip"] = String.Format("{0}（值：{1}）", item.Text, item.Value);
        }

        // // 方法二：直接读取数据源
        // var index = 0;
        // foreach (var dataItem in CheckBoxList2.DataSource as List<CheckBoxListTooltipModel.TestClass>)
        // {
        //     CheckBoxList2.Items[index].Attributes["data-qtip"] = String.Format("{0}（值：{1}）", dataItem.Name, dataItem.Id);
        //     index++;
        // }

    }

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在视图中为声明项和数据绑定项逐项设置悬停提示。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看每个选项的提示</h3>
        <ol>
            <li>
                将鼠标移到<strong class="example-control-reference" data-example-control="CheckBoxList1" title="列表一">列表一</strong>的“可选项 <code>1</code>”。<br />
                结果：显示“这是第一个选项的提示信息”。
            </li>
            <li>
                将鼠标移到<strong class="example-control-reference" data-example-control="CheckBoxList2" title="列表二（一列）">列表二</strong>的“数据绑定值 <code>1</code>”。<br />
                结果：该数据项的提示显示“数据绑定值 <code>1</code>（值：<code>item1</code>）”；本页在视图中绑定后遍历选项补充提示。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：在页面视图上，通过遍历数据源来更新下拉列表每一项的属性。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Attributes[&quot;data-qtip&quot;]</code>（<strong class="example-control-reference" data-example-control="CheckBoxList1"
                    title="列表一">列表一</strong>、<strong class="example-control-reference" data-example-control="CheckBoxList2"
                    title="列表二（一列）">列表二（一列）</strong>）：给选项写入悬停提示文字；按选项索引设置固定提示，数据项提示按当前项的文字和值生成。</li>
            <li><code>ColumnNumber</code>（<strong class="example-control-reference" data-example-control="CheckBoxList2"
                    title="列表二（一列）">列表二（一列）</strong>）：决定列表分为几列。 本页<strong class="example-control-reference" data-example-control="CheckBoxList2"
                    title="列表二（一列）">列表二（一列）</strong>声明值为 <code>1</code>。</li>
            <li><code>SelectedValueArray</code>（<strong class="example-control-reference" data-example-control="CheckBoxList2"
                    title="列表二（一列）">列表二（一列）</strong>）：指定初始或后台设置的多个选中值。</li>
        </ul>
    </section>
}
