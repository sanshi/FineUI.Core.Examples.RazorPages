@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.NumberBoxRoundModel
@{
    ViewBag.Title = "Form/NumberBoxRound";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false"
                  Title="简单表单" LabelWidth="120">
        <Items>
            <f:NumberBox Label="小数（两位精度，初始值：1.2367）" ID="NumberBox1" Text="1.2367" Required="true" ShowRedStar="true" />
            <f:NumberBox Label="小数（两位精度，禁用四舍五入，初始值：1.2367）" ID="NumberBox2" Text="1.2367" EnableRound="false" Required="true" ShowRedStar="true" />
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单"
                      OnClick="Url.Handler("btnSubmit_Click")" OnClickFields="SimpleForm1"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

