@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.NumberBoxDecimalPrecisionModel
@{
    ViewBag.Title = "Form/NumberBoxDecimalPrecision";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false" Title="简单表单" LabelWidth="120">
        <Items>
            <f:NumberBox ID="NumberBox1" EmptyText="精度为 2，比如 0.35" Label="0 到 1 之间的小数" Text="0.356" MaxValue="1" MinValue="0" NoDecimal="false"
                NoNegative="true" DecimalPrecision="2" Required="true" ShowRedStar="true" Increment="0.01" TrimEndZero="false">
            </f:NumberBox>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="@Url.Handler("btnSubmit_Click")" OnClickParameter1="@(Parameter.FromFunction("number", "getNumberBox1NumberPostbackValue"))">
            </f:Button>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Top">
                <Items>
                    <f:Button ID="Button1" Text="修改精度为 1" OnClick="@Url.Handler("Button1_Click")"></f:Button>
                    <f:Button ID="Button2" Text="修改精度为 2" OnClick="@Url.Handler("Button2_Click")"></f:Button>
                    <f:Button ID="Button3" Text="修改精度为 3" OnClick="@Url.Handler("Button3_Click")"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getNumberBox1NumberPostbackValue() {
            return F.ui.NumberBox1.getValue();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在同一个<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 1 之间的小数">数字输入框</strong>中切换
            <code>1</code>、<code>2</code>、<code>3</code> 位小数，同时调整增减步长并保留末尾的零。
        </p>
        <h3><i class="f-icon f-iconfont f-iconfont-sort" aria-hidden="true"></i>切换精度和步长</h3>
        <ol>
            <li>
                输入<code>0.36</code>，点击<strong class="example-control-reference" data-example-control="Button3" title="修改精度为 3">修改精度为 3</strong>。<br />
                结果：回发后由后台将小数位数设为 <code>3</code>、步长设为 <code>0.001</code>，输入框显示 <code>0.360</code>。
            </li>
            <li>
                点击向上的增减图标。<br />
                结果：数值变为 <code>0.361</code>。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="Button1" title="修改精度为 1">修改精度为 1</strong>。<br />
                结果：回发后由后台改为 <code>1</code> 位小数和 <code>0.1</code> 的步长，当前值显示为 <code>0.4</code>。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="Button2" title="修改精度为 2">修改精度为 2</strong>，再点击<strong
                    class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>。<br />
                结果：回发后由后台改为 <code>2</code> 位小数和 <code>0.01</code> 的步长，输入框显示 <code>0.40</code>；提交后由后台显示当前数字值。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：为<strong class="example-control-reference" data-example-control="NumberBox1"
                title="0 到 1 之间的小数">数字输入框</strong>设置了<code>TrimEndZero</code>=<code>false</code>，所以不会去掉末尾的零（比如精度为<code>3</code>时，会显示<code>0.360</code>，而不是<code>0.36</code>）。
        </p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DecimalPrecision</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 1 之间的小数">0 到 1
                    之间的小数</strong>）：控制小数位数，三个按钮分别设置为 <code>1</code>、<code>2</code>、<code>3</code>。</li>
            <li><code>Increment</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 1 之间的小数">0 到 1
                    之间的小数</strong>）：随精度分别设置为 <code>0.1</code>、<code>0.01</code>、<code>0.001</code>。</li>
            <li><code>TrimEndZero</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 1 之间的小数">0 到 1
                    之间的小数</strong>）：初始为 <code>false</code>，<code>0.36</code> 在 <code>3</code> 位精度下显示为 <code>0.360</code>。</li>
        </ul>
    </section>
}
