@page
@model FineUI.Core.Examples.RazorPages.Pages.Form.CheckBoxListSwitchModel
@{
    ViewBag.Title = "Form/CheckBoxListSwitch";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="160" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:CheckBoxList ID="CheckBoxList1" Label="列表一" DisplayType="Switch">
                <f:CheckItem Text="可选项 1" Value="value1" />
                <f:CheckItem Text="可选项 2" Value="value2" Selected="true" />
                <f:CheckItem Text="可选项 3" Value="value3" Selected="true" />
            </f:CheckBoxList>
            <f:Panel CssClass="f-field" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Button ID="btnServerSetSelectedValue" CssClass="marginr" Text="选中上面列表中的第一项和第三项" OnClick="@Url.Handler("btnServerSetSelectedValue_Click")"></f:Button>
                    <f:Button ID="btnServerGetSelectedValue" CssClass="marginr" Text="获取上面列表的选中项" OnClick="@Url.Handler("btnServerGetSelectedValue_Click")" OnClickParameter1="@(Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue"))"></f:Button>
                    <f:Button ID="btnClientGetSelectedValue" Text="获取上面列表的选中项（JavaScript 脚本）" ClickHandler="onAlertSelectedValueClick"></f:Button>
                </Items>
            </f:Panel>
            <f:Label></f:Label>
            <f:CheckBoxList ID="CheckBoxList2" Label="列表二（一列）" ColumnNumber="1"
                            DataTextField="Name" DataValueField="Id" DataSource="@ViewBag.CheckBoxList2DataSource"
                            SelectedValueArray="@ViewBag.CheckBoxList2SelectedValueArray" DisplayType="Switch">
            </f:CheckBoxList>
            <f:Label></f:Label>
            <f:CheckBoxList ID="CheckBoxList3" Label="列表三（选中项改变事件）" ColumnNumber="3" ShowRedStar="true" Required="true"
                            OnSelectedIndexChanged="@Url.Handler("CheckBoxList3_SelectedIndexChanged")" OnSelectedIndexChangedParameter1="@(Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue2"))" DisplayType="Switch" SwitchTextVisible="true">
                <f:CheckItem Text="可选项 1（很长很长很长很长很长很长的可选项）" Value="value1" />
                <f:CheckItem Text="可选项 2" Value="value2" />
                <f:CheckItem Text="可选项 3" Value="value3" />
                <f:CheckItem Text="可选项 4" Value="value4" />
                <f:CheckItem Text="可选项 5" Value="value5" />
                <f:CheckItem Text="可选项 6" Value="value6" />
                <f:CheckItem Text="可选项 7" Value="value7" />
                <f:CheckItem Text="可选项 8" Value="value8" />
            </f:CheckBoxList>
            <f:Label></f:Label>
            <f:CheckBoxList ID="rblVertical" Label="列表四（竖排）" ColumnNumber="3" ColumnVertical="true" ShowRedStar="true" Required="true" DisplayType="Switch" SwitchTextVisible="true" SwitchOnText="是" SwitchOffText="否">
                <Items>
                    <f:CheckItem Text="可选项 1" Value="value1" />
                    <f:CheckItem Text="可选项 2" Value="value2" />
                    <f:CheckItem Text="可选项 3" Value="value3" />
                    <f:CheckItem Text="可选项 4" Value="value4" />
                    <f:CheckItem Text="可选项 5" Value="value5" />
                    <f:CheckItem Text="可选项 6" Value="value6" />
                    <f:CheckItem Text="可选项 7" Value="value7" />
                    <f:CheckItem Text="可选项 8" Value="value8" />
                </Items>
            </f:CheckBoxList>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="@Url.Handler("btnSubmit_Click")" OnClickFields="SimpleForm1"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedPostbackValue() {
            return getCheckBoxList1Selected();
        }

        function getCurrentControlSelectedPostbackValue2() {
            return this.getValue();
        }

    </script>

    <script type="text/javascript">

        function onAlertSelectedValueClick(event) {
            var list1 = F.ui.CheckBoxList1;

            var selectedValues = list1.getValue();
            if (selectedValues.length) {
                top.F.alert("列表一的选中项：" + selectedValues.join(','));
            } else {
                top.F.alert("列表一没有选中项！");
            }
        }


        function getCheckBoxList1Selected() {
            var list = F.ui.CheckBoxList1;

            var result = [];
            $.each(list.items, function (index, item) {
                if (item.isChecked()) {
                    result.push({
                        'label': item.getInputLabel(),
                        'value': item.getInputValue()
                    });
                }
            });

            return F.toJSON(result);
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>将复选列表显示为开关，并对比默认、自定义状态文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-power-off" aria-hidden="true"></i>切换开关选项</h3>
        <ol>
            <li>
                切换<strong class="example-control-reference" data-example-control="CheckBoxList1" title="列表一">列表一</strong>的第一个开关。<br />
                结果：该项的选中状态改变，其它开关独立保持当前状态。
            </li>
            <li>
                切换带状态文字的<strong class="example-control-reference" data-example-control="rblVertical" title="列表四（竖排）">列表四</strong>开关。<br />
                结果：状态文字随开关在“是”和“否”间改变。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="CheckBoxList1" title="列表一">列表一</strong>）：使用开关外观，选择值仍是复选列表的多值集合。 本页<strong class="example-control-reference" data-example-control="CheckBoxList1" title="列表一">列表一</strong>声明值为 <code>Switch</code>。</li>
            <li><code>SwitchTextVisible</code>（<strong class="example-control-reference" data-example-control="CheckBoxList3" title="列表三（选中项改变事件）">列表三（选中项改变事件）</strong>）：显示开关状态文字。 本页<strong class="example-control-reference" data-example-control="CheckBoxList3" title="列表三（选中项改变事件）">列表三（选中项改变事件）</strong>声明值为 <code>true</code>。</li>
            <li><code>SwitchOnText</code>（<strong class="example-control-reference" data-example-control="rblVertical" title="列表四（竖排）">列表四（竖排）</strong>）：开关开启状态的文字。 本页<strong class="example-control-reference" data-example-control="rblVertical" title="列表四（竖排）">列表四（竖排）</strong>声明值为 是。</li>
            <li><code>SwitchOffText</code>（<strong class="example-control-reference" data-example-control="rblVertical" title="列表四（竖排）">列表四（竖排）</strong>）：开关关闭状态的文字。 本页<strong class="example-control-reference" data-example-control="rblVertical" title="列表四（竖排）">列表四（竖排）</strong>声明值为 否。</li>
        </ul>
    </section>
}
