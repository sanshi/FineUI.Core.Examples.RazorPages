@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.SalesModel
@using FineUI.Core
@using FineUI.Core.Examples.RazorPages.Pages.Chart
@{
    ViewBag.SourceFiles = "~/Pages/Chart/ChartSamples.cs";
    ViewBag.Title = "图表绑定与 Grid 联动";
    var F = Html.F();
    var orders = ChartSamples.Details();
}

@section body {
    @(F.Panel().IsFluid(true).Layout(LayoutType.Block).BlockConfigSpace(16).ShowHeader(false).ShowBorder(false)
        .Items(
            F.Panel().BlockLG(7).Height(550).Layout(LayoutType.Fit).ShowHeader(true).ShowBorder(true).Title("月度销售额（元）").BodyPadding(8)
                .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(
                    F.Button().ID("btnRecent").Text("最近两个月").CssClass("marginr").OnClick(Url.Handler("Recent")),
                    F.Button().ID("btnReset").Text("显示全部").OnClick(Url.Handler("Reset"))))
                .Items(F.Chart().ID("ChartSales").CategoryField("Category")
                    .Series("sales", ChartSeriesType.Bar, "销售额", "Amount")
                    .DataSource(ChartSamples.Months())
                    .DataKeyField("Month").OnPointClick(Url.Handler("PointClick"))),
            F.Grid().ID("GridOrders").BlockLG(5).Height(550).Title("订单明细").ShowHeader(true).ShowBorder(true)
                .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(
                    F.ToolbarText().ID("ToolbarTextOrderScope").Text(ChartSamples.OrderScope(null, false, orders.Length))))
                .Columns(
                    F.RenderField().ColumnID("Number").DataField("Number").HeaderText("订单号").Width(80),
                    F.RenderField().ColumnID("Customer").DataField("Customer").HeaderText("客户").Width(78).ExpandUnusedSpace(true),
                    F.RenderField().ColumnID("Month").DataField("Month").HeaderText("月份").Width(80),
                    F.RenderField().ColumnID("Amount").DataField("Amount").HeaderText("金额").Width(84).TextAlign(TextAlign.Right))
                .DataSource(orders)))
    <p>点击月份柱可查看当月订单。「最近两个月」同时缩小图表和明细的范围，「显示全部」恢复六个月。页面使用演示订单数据。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>.DataKeyField("Month")</code>
                点击月份柱时传递业务键，例如 2026-09。横轴上的「9 月」只用于显示。
            </li>
            <li>
                <code>.OnPointClick(Url.Handler("PointClick"))</code>
                将点击交给后台处理，用月份业务键筛选订单并更新 Grid。
            </li>
        </ul>
    </section>
}
