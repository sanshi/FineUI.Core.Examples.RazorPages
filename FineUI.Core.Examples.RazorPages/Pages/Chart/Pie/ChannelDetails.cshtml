@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Pie.ChannelDetailsModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/ChannelVisitData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "饼图扇区联动渠道明细表";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Layout(LayoutType.Block).BlockConfigSpace(16).ShowHeader(false).ShowBorder(false)
        .Items(
            F.Panel().BlockLG(6).Height(550).Layout(LayoutType.Fit).Title("访问渠道占比").ShowHeader(true).ShowBorder(true).BodyPadding(8)
                .Items(
                    F.Chart().ID("ChartChannelDetails").DataCategoryField("Category")
                        .Series("amount", ChartSeriesType.Pie, "访问量", "Amount")
                        .DataSource((object)ViewData["Rows"])
                        .DataIDField("Id").OnPointClick(Url.Handler("ChartChannelDetails_PointClick"))),
            F.Grid().ID("GridChannelMonths").BlockLG(6).Title("月度访问明细").ShowHeader(true).ShowBorder(true).Height(550)
                .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(
                    F.Button().ID("btnClear").Text("清除选择").CssClass("marginr").OnClick(Url.Handler("btnClear_Click")),
                    F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
                .Columns(
                    F.RenderField().DataField("Category").HeaderText("月份").ExpandUnusedSpace(true),
                    F.RenderField().DataField("Amount").HeaderText("访问量").Width(100).TextAlign(TextAlign.Right))))

    <p>点击渠道扇区，明细表显示该渠道六个月的访问量。点击「清除选择」恢复空明细，饼图继续展示全部渠道。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li><code>.DataIDField("Id")</code> 扇区提交渠道编号，例如 search 表示搜索。</li>
            <li><code>.OnPointClick(...)</code> 按渠道查询月度记录，刷新 Grid 和当前选择说明。</li>
        </ul>
    </section>
}
