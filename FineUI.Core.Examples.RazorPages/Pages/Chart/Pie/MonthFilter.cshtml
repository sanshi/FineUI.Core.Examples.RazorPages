@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Pie.MonthFilterModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/ChannelVisitData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "下拉筛选饼图月份";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Title("访问渠道构成").ShowHeader(true).ShowBorder(true).BodyPadding(8)
        .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
        .Items(
            F.SimpleForm().IsFluid(true).MaxWidth(240).ShowHeader(false).ShowBorder(false).LabelWidth(64)
                .Items(
                    F.DropDownList().ID("ddlMonth").Label("月份")
                        .OnSelectedIndexChanged(Url.Handler("ddlMonth_SelectedIndexChanged"), Parameter.FromFunction("month", "readChartFilter"))
                        .Items(
                            F.ListItem().Text("全部月份").Value("all").Selected(true),
                            F.ListItem().Text("4 月").Value("2026-04"),
                            F.ListItem().Text("5 月").Value("2026-05"),
                            F.ListItem().Text("6 月").Value("2026-06"),
                            F.ListItem().Text("7 月").Value("2026-07"),
                            F.ListItem().Text("8 月").Value("2026-08"),
                            F.ListItem().Text("9 月").Value("2026-09"))),
            F.Chart().ID("ChartChannelMonth").Height(550).DataCategoryField("Category")
                .Series("amount", ChartSeriesType.Pie, "访问量", "Amount")
                .DataSource((object)ViewData["Rows"])))

    <p>从下拉列表选择一个月份，饼图显示当月各渠道占比。选择「全部月份」可恢复六个月汇总。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li><code>DropDownList</code> 下拉项使用完整月份键，全部月份使用 all。</li>
            <li><code>.OnSelectedIndexChanged(...)</code> 后台使用同一批数据计算扇区和总访问量。</li>
        </ul>
    </section>
}

@section script {
    <script>
        function readChartFilter() {
            return this.getValue();
        }
    </script>
}
