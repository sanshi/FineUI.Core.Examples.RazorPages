@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Bar.DrillDownModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/RegionSalesData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "柱状图钻取与返回";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Title("区域销售分析").ShowHeader(true).ShowBorder(true).BodyPadding(8)
        .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(
            F.Button().ID("btnBack").Text("返回区域").Enabled(false).CssClass("marginr").OnClick(Url.Handler("btnBack_Click")),
            F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
        .Items(
            F.Chart().ID("ChartRegionSales").Height(550).DataCategoryField("Category")
                .Series("amount", ChartSeriesType.Bar, "销售额（元）", "Amount")
                .DataSource((object)ViewData["Rows"])
                .DataIDField("Id").OnPointClick(Url.Handler("ChartRegionSales_PointClick"))))



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>先查看各区域的销售额，再点击区域柱钻取城市明细。「返回区域」恢复汇总。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>钻取后返回汇总</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="ChartRegionSales"
                    title="图表">图表</strong>中的区域柱。<br />结果：后台用该区域城市销售额替换汇总柱，<strong class="example-control-reference" data-example-control="btnBack"
                    title="返回区域">返回区域</strong>按钮变为可用。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnBack" title="返回区域">返回区域</strong>。<br />结果：恢复区域汇总，返回按钮恢复不可用。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>.DataIDField(&quot;Id&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartRegionSales"
                    title="图表">图表</strong>）：用区域编号识别被点击的柱，例如 east 表示华东。</li>
            <li><code>.OnPointClick(...)</code>（<strong class="example-control-reference" data-example-control="ChartRegionSales"
                    title="图表">图表</strong>）：后台在同一张图表中重绑城市数据；城市是末级，点击后保持当前视图。</li>
        </ul>
    </section>
}
