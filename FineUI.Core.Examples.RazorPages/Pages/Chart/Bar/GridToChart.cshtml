@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Bar.GridToChartModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/RegionSalesData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "Grid 选行联动柱状图";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Layout(LayoutType.Block).BlockConfigSpace(16).ShowHeader(false).ShowBorder(false)
        .Items(
            F.Grid().ID("GridRegions").BlockLG(4).Title("区域").ShowHeader(true).ShowBorder(true).Height(550)
                .DataIDField("Id").OnRowClick(Url.Handler("GridRegions_RowClick"), Parameter.FromEventArgument("rowId", 1))
                .Columns(
                    F.RenderField().DataField("Category").HeaderText("区域").ExpandUnusedSpace(true),
                    F.RenderField().DataField("Amount").HeaderText("累计销售额").Width(108).TextAlign(TextAlign.Right))
                .DataSource((object)ViewData["Regions"]),
            F.Panel().BlockLG(8).Height(550).Layout(LayoutType.Fit).Title("月度销售额（元）").ShowHeader(true).ShowBorder(true).BodyPadding(8)
                .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(
                    F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
                .Items(
                    F.Chart().ID("ChartRegionMonths").DataCategoryField("Category")
                        .Series("amount", ChartSeriesType.Bar, "销售额（元）", "Amount")
                        .DataSource((object)ViewData["Rows"]))))



}

@section exampleDescription {
<section aria-label="页面描述">
    <p>点击区域表格的一行，右侧柱状图显示该区域 4 至 9 月的销售额。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>从表格选择区域</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="GridRegions" title="区域">区域</strong>点击另一条区域记录。<br />结果：后台按区域重新绑定<strong class="example-control-reference" data-example-control="ChartRegionMonths" title="图表">图表</strong>，显示该区域 4 至 9 月销售额，范围文字同步更新。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>.DataIDField(&quot;Id&quot;)</code>（<strong class="example-control-reference" data-example-control="GridRegions" title="区域">区域</strong>）：Grid 使用区域业务键识别当前行，例如 east 对应华东。</li>
        <li><code>.OnRowClick(...)</code>（<strong class="example-control-reference" data-example-control="GridRegions" title="区域">区域</strong>）：后台通过行的业务键查询该区域的月度销售额，并更新柱状图。</li>
    </ul>
</section>
}
