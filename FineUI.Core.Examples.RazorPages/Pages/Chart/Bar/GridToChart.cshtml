@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Bar.GridToChartModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/ChartInteractionData.cs";
    ViewBag.Title = "Grid 选行联动柱状图";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Layout(LayoutType.Block).BlockConfigSpace(16).ShowHeader(false).ShowBorder(false)
        .Items(
            F.Grid().ID("GridRegions").BlockLG(4).Title("区域").ShowHeader(true).ShowBorder(true).Height(550)
                .DataIDField("Key").OnRowClick(Url.Handler("GridRegions_RowClick"), Parameter.FromEventArgument("rowId", 1))
                .Columns(
                    F.RenderField().DataField("Category").HeaderText("区域").ExpandUnusedSpace(true),
                    F.RenderField().DataField("Amount").HeaderText("累计销售额").Width(108).TextAlign(TextAlign.Right))
                .DataSource((object)ViewData["Regions"]),
            F.Panel().BlockLG(8).Height(550).Layout(LayoutType.Fit).Title("月度销售额（元）").ShowHeader(true).ShowBorder(true).BodyPadding(8)
                .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(
                    F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
                .Items(
                    F.Chart().ID("ChartRegionMonths").CategoryField("Category")
                        .Series("amount", ChartSeriesType.Bar, "销售额（元）", "Amount")
                        .DataSource((object)ViewData["Rows"]))))

    <p>点击区域表格的一行，右侧柱状图显示该区域 4 至 9 月的销售额。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li><code>.DataIDField("Key")</code> Grid 使用区域业务键识别当前行，例如 east 对应华东。</li>
            <li><code>.OnRowClick(...)</code> 后台通过行的业务键查询该区域的月度销售额，并更新柱状图。</li>
        </ul>
    </section>
}
