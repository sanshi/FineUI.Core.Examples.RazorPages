@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Line.DateFocusModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/ChartInteractionData.cs";
    ViewBag.Title = "折线图与日期选择器双向联动";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Title("每日访问量").ShowHeader(true).ShowBorder(true).BodyPadding(8)
        .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
        .Items(
            F.SimpleForm().IsFluid(true).ShowHeader(false).ShowBorder(false).LabelWidth(108)
                .Items(
                    F.DatePicker().ID("dpFocus").Label("日期").DateFormatString("yyyy-MM-dd").Text("2026-09-01"),
                    F.Button().ID("btnFocus").Text("查看当天").OnClick(Url.Handler("ReadDate"), "dpFocus")),
            F.Chart().ID("ChartDateFocus").Height(550).CategoryField("Category")
                .Series(new ChartSeries
                {
                    Key = "amount", Type = ChartSeriesType.Line, Name = "访问量",
                    ValueField = "Amount", ColorField = "Color"
                })
                .DataSource((object)ViewData["Rows"])
                .DataKeyField("Key").OnPointClick(Url.Handler("FocusDate"))))

    <p>点击折线上的日期点会填写日期并显示当天数据。也可以直接在日期选择器中选择一天，再点击「查看当天」。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li><code>.DataKeyField("Key")</code> 折线点提交完整日期，例如 2026-09-03，后台按该日期填写日期选择器。</li>
            <li><code>.OnClick(...)</code> 查询按钮读取日期选择器，和点选共用同一条记录查询。</li>
        </ul>
    </section>
}
