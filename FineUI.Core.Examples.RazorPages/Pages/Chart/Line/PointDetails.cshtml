@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Line.PointDetailsModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/ChartInteractionData.cs";
    ViewBag.Title = "点击折线点查看详情";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Title("每日访问量").ShowHeader(true).ShowBorder(true).BodyPadding(8)
        .Items(
            F.Chart().ID("ChartDailyVisits").Height(550).CategoryField("Category")
                .Series("amount", ChartSeriesType.Line, "访问量", "Amount")
                .DataSource((object)ViewData["Rows"])
                .DataKeyField("Key").OnPointClick(Url.Handler("ChartDailyVisits_PointClick"))))
    @(F.Window().ID("WindowVisitDetails").Title("访问详情").Hidden(true).IsModal(true).EnableClose(true)
        .Width(320).Height(210).BodyPadding(16)
        .Items(
            F.Label().ID("labVisitDate").ShowLabel(false),
            F.Label().ID("labVisitCount").ShowLabel(false),
            F.Label().ID("labConversionCount").ShowLabel(false),
            F.Label().ID("labConversionRate").ShowLabel(false)))

    <p>点击折线上的日期数据点，弹出当日访问量、转化量和转化率。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li><code>.DataKeyField("Key")</code> 以完整日期识别记录，例如 2026-09-03。</li>
            <li><code>.OnPointClick(...)</code> 后台按日期读取完整记录，填充详情 Window，再打开窗口。</li>
        </ul>
    </section>
}
