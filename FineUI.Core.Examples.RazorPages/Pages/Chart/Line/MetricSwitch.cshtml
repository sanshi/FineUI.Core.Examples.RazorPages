@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Line.MetricSwitchModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/DailyVisitData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "单选切换折线指标";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Title("每日指标趋势").ShowHeader(true).ShowBorder(true).BodyPadding(8)
        .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
        .Items(
            F.SimpleForm().IsFluid(true).ShowHeader(false).ShowBorder(false).LabelWidth(108)
                .Items(
                    F.RadioButtonList().ID("rblMetric").Label("指标").AutoColumnWidth(true)
                        .OnSelectedIndexChanged(Url.Handler("rblMetric_SelectedIndexChanged"), Parameter.FromFunction("metric", "readChartFilter"))
                        .Items(
                            F.RadioItem().Text("访问量").Value("visits").Selected(true),
                            F.RadioItem().Text("转化量").Value("conversions"))),
            F.Chart().ID("ChartMetricTrend").Height(550).DataCategoryField("Category")
                .Series("amount", ChartSeriesType.Line, "人数", "Amount")
                .DataSource((object)ViewData["Rows"])))



}

@section script {
    <script>
        function readChartFilter() {
            return this.getValue();
        }
    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>选择「访问量」或「转化量」，在同一张折线图上查看对应指标。日期范围保持一致，汇总随指标更新。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换统计指标</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="rblMetric" title="指标">指标</strong>选择转化量。<br />结果：后台更新折线、系列名称和汇总，日期范围保持不变。</li>
        <li>重新选择访问量。<br />结果：恢复访问量口径，不叠加上一次指标。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Items</code>（<strong class="example-control-reference" data-example-control="rblMetric" title="指标">指标</strong>）：使用稳定选项键 visits 和 conversions 切换统计口径。</li>
        <li><code>.OnSelectedIndexChanged(...)</code>（<strong class="example-control-reference" data-example-control="ChartMetricTrend" title="图表">图表</strong>）：选项改变后重新绑定系列数值，分类日期保持一致。</li>
    </ul>
</section>
}
