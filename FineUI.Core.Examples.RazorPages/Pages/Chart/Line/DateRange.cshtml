@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Line.DateRangeModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/DailyVisitData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "日期范围筛选折线图";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Title("每日访问趋势").ShowHeader(true).ShowBorder(true).BodyPadding(8)
        .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(
            F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
        .Items(
            F.SimpleForm().ID("SimpleFormDateRange").IsFluid(true).MaxWidth(280).ShowHeader(false).ShowBorder(false).LabelAlign(LabelAlign.Top)
                .Items(
                    F.DatePicker().ID("dpVisitRange").Label("日期范围").DateFormatString("yyyy-MM-dd")
                        .DisplayType(CalendarDisplayType.DayRange).EnableEdit(false)
                        .Text(ViewData["VisitRange"] as string).OnTextChanged(Url.Handler("dpVisitRange_TextChanged"), "dpVisitRange")),
            F.Chart().ID("ChartVisitRange").Height(550).DataCategoryField("Category")
                .Series("amount", ChartSeriesType.Line, "访问量", "Amount")
                .DataSource((object)ViewData["Rows"])))



}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在日期范围选择器中选完起止日期，折线和访问量汇总会自动更新。演示数据覆盖 2026 年 9 月 1 日至 12 日。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>选定起止日期</h3>
    <ul>
        <li>打开<strong class="example-control-reference" data-example-control="dpVisitRange" title="日期范围">日期范围</strong>，依次选择 2026-09-03 和 2026-09-06。<br />结果：选完两个日期后后台筛选区间数据，折线只保留 9 月 3 日至 6 日的点，汇总同步更新。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>.DisplayType(CalendarDisplayType.DayRange)</code>（<strong class="example-control-reference" data-example-control="ChartVisitRange" title="图表">图表</strong>）：在同一个弹层中选择开始和结束日期，两端都计入统计。选完第二个日期时触发更新。</li>
        <li><code>UIHelper.Chart(...).LoadData(...)</code>（<strong class="example-control-reference" data-example-control="ChartVisitRange" title="图表">图表</strong>）：同一批查询结果同时用于绘制折线、计算天数和访问量。</li>
    </ul>
</section>
}
