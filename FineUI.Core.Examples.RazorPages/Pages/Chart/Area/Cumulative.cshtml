@page
@model FineUI.Core.Examples.RazorPages.Pages.Chart.Area.CumulativeModel
@using FineUI.Core
@{
    ViewBag.SourceFiles = "~/Pages/Chart/ChartInteractionData.cs";
    ViewBag.Title = "复选切换累计面积图";
    var F = Html.F();
}

@section body {
    @(F.Panel().IsFluid(true).Title("区域销售趋势").ShowHeader(true).ShowBorder(true).BodyPadding(8)
        .Toolbars(F.Toolbar().Position(ToolbarPosition.Top).Items(F.ToolbarText().ID("ToolbarTextChartScope").Text(ViewData["Scope"] as string)))
        .Items(
            F.SimpleForm().IsFluid(true).ShowHeader(false).ShowBorder(false).LabelWidth(108)
                .Items(
                    F.CheckBox().ID("cbxCumulative").ShowLabel(false).Text("按月累计")
                        .OnCheckedChanged(Url.Handler("cbxCumulative_CheckedChanged"), Parameter.FromFunction("cumulative", "readChartFilter"))),
            F.Chart().ID("ChartCumulativeSales").Height(550).CategoryField("Category")
                .Series("amount", ChartSeriesType.Area, "销售额（元）", "Amount")
                .DataSource((object)ViewData["Rows"])))

    <p>勾选「按月累计」，面积图每个点显示从 4 月到该月的销售额合计。取消勾选恢复每月独立金额。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li><code>.OnCheckedChanged(...)</code> 用当前复选状态选择本月值或截至当月累计值。</li>
            <li><code>LoadData(...)</code> 累计由后台按月份顺序计算。例如 4 月与 5 月相加后才得到 5 月的累计值。</li>
        </ul>
    </section>
}

@section script {
    <script>
        function readChartFilter() {
            return this.getValue();
        }
    </script>
}
