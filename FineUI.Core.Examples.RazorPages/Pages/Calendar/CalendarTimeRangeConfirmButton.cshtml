@page
@model FineUI.Core.Examples.RazorPages.Pages.Calendar.CalendarTimeRangeConfirmButtonModel
@{
    ViewBag.Title = "Calendar/CalendarTimeRangeConfirmButton";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" DateFormatString="@ViewBag.Calendar1DateFormatString"
                OnDateSelect="@Url.Handler("Calendar1_DateSelect")" OnDateSelectParameter1="@(new Parameter("text", "F.ui.Calendar1.getText()"))"
                Text="@ViewBag.Calendar1Text"
                DisplayType="TimeRange" ShowConfirmButton="true" ConfirmToSelect="true">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="@Url.Handler("Button1_Click")" Text="@ViewBag.Button1Text"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}

