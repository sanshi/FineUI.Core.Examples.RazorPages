@page
@model FineUI.Core.Examples.RazorPages.Pages.Calendar.CalendarDayRangeModel
@{
    ViewBag.Title = "Calendar/CalendarDayRange";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" DateFormatString="@ViewBag.Calendar1DateFormatString"
        OnDateSelect="@Url.Handler("Calendar1_DateSelect")" OnDateSelectParameter1="@(Parameter.FromFunction("text", "getCalendar1TextPostbackValue"))"
        RangeStartDate="@ViewBag.Calendar1RangeStartDate" RangeEndDate="@ViewBag.Calendar1RangeEndDate"
        DisplayType="DayRange">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="@Url.Handler("Button1_Click")" Text="@ViewBag.Button1Text"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1TextPostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接选择日期范围。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期范围</h3>
        <ul>
            <li>
                依次将起点和终点选择为今天之后第<code>5</code>天到第<code>10</code>天。<br />
                结果：面板高亮当前选择，范围显示起止两个值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>响应选择事件</h3>
        <ul>
            <li>
                改变当前日期范围并完成选择。<br />
                结果：触发本页选择事件回发，后台读取当前选择并更新下方结果。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>由按钮设置选择</h3>
        <ul>
            <li>
                点击日历下方以“选中”开头的按钮。<br />
                结果：后台把日历改为按钮文字标明的日期范围；面板高亮随之更新，下方显示当前值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：控制选中值的文字格式；本页使用 <code>yyyy</code>-<code>MM</code>-<code>dd</code>。</li>
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：本页采用日期范围面板，选择起点和终点。</li>
            <li><code>RangeStartDate</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设置范围起点，与终点共同组成当前范围。</li>
            <li><code>RangeEndDate</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设置范围终点，与起点共同组成当前范围。</li>
            <li><code>OnDateSelect</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：完成日历选择后回发，后台读取当前选择并更新结果标签。</li>
        </ul>
    </section>
}
