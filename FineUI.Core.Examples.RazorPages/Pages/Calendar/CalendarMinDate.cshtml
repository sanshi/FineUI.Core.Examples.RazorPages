@page
@model FineUI.Core.Examples.RazorPages.Pages.Calendar.CalendarMinDateModel
@{
    ViewBag.Title = "Calendar/CalendarMinDate";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" DateFormatString="@ViewBag.Calendar1DateFormatString" SelectedDate="@ViewBag.Calendar1SelectedDate"
                MinDate="@ViewBag.Calendar1MinDate" MaxDate="@ViewBag.Calendar1MaxDate"
                OnDateSelect="@Url.Handler("Calendar1_DateSelect")" OnDateSelectParameter1="@(new Parameter("selectedDate", "F.ui.Calendar1.getText()"))">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="@Url.Handler("Button1_Click")" Text="@ViewBag.Button1Text"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}

