@page
@model FineUI.Core.Examples.RazorPages.Pages.Calendar.CalendarModel
@{
    ViewBag.Title = "Calendar/Calendar";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" DateFormatString="@ViewBag.Calendar1DateFormatString" SelectedDate="@ViewBag.Calendar1SelectedDate" OnDateSelect="@Url.Handler("Calendar1_DateSelect")" OnDateSelectParameter1="@(Parameter.FromFunction("selectedDate", "getCalendar1SelectedDatePostbackValue"))">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="@Url.Handler("Button1_Click")" Text="@ViewBag.Button1Text"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1SelectedDatePostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}
