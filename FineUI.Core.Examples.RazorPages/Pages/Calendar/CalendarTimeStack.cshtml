@page
@model FineUI.Core.Examples.RazorPages.Pages.Calendar.CalendarTimeStackModel
@{
    ViewBag.Title = "Calendar/CalendarTimeStack";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" DateFormatString="@ViewBag.Calendar1DateFormatString" SelectedDate="@ViewBag.Calendar1SelectedDate" OnDateSelect="@Url.Handler("Calendar1_DateSelect")"
        OnDateSelectParameter1="@(Parameter.FromFunction("selectedDate", "getCalendar1SelectedDatePostbackValue"))" ShowTime="true" StackDateTime="true">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="@Url.Handler("Button1_Click")" Text="@ViewBag.Button1Text"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1SelectedDatePostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示把日期网格与时间列上下排列，在同一面板选择日期和时间。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>在同一面板上下选择日期和时间</h3>
        <ol>
            <li>
                展开日期时间面板，对照日期与时间区域，再分别调整日期、小时和分钟。<br />
                结果：日期和时间上下排列在同一个面板中，无需在两种视图之间来回切换。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>StackDateTime</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：初始为
                <code>true</code>，日期网格与时间列上下排列，适合较窄的面板。
            </li>
        </ul>
    </section>
}
