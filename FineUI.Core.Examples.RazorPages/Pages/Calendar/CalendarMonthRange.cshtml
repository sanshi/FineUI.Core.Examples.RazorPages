@page
@model FineUI.Core.Examples.RazorPages.Pages.Calendar.CalendarMonthRangeModel
@{
    ViewBag.Title = "Calendar/CalendarMonthRange";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" DateFormatString="@ViewBag.Calendar1DateFormatString"
                OnDateSelect="@Url.Handler("Calendar1_DateSelect")" OnDateSelectParameter1="@(Parameter.FromFunction("text", "getCalendar1TextPostbackValue"))"
                RangeStartDate="@ViewBag.Calendar1RangeStartDate" RangeEndDate="@ViewBag.Calendar1RangeEndDate"
                MinDate="@ViewBag.Calendar1MinDate" MaxDate="@ViewBag.Calendar1MaxDate"
                DisplayType="MonthRange">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="@Url.Handler("Button1_Click")" Text="@ViewBag.Button1Text"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1TextPostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接只选择年月范围。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择年月范围</h3>
        <ul>
            <li>
                依次将起点和终点选择为当前月份之后第<code>1</code>个月到第<code>2</code>个月。<br />
                结果：面板高亮当前选择，范围显示起止两个值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设为<code>yyyy/MM</code>，控制选中值的文字格式。</li>
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：本页采用年月范围面板，选择起点和终点。</li>
        </ul>
    </section>
}
