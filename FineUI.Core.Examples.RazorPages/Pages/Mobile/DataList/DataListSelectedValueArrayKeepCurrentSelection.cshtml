@page
@model FineUI.Core.Examples.RazorPages.Pages.Mobile.DataList.DataListSelectedValueArrayKeepCurrentSelectionModel
@{
    ViewBag.Title = "MobileDataList/DataListSelectedValueArrayKeepCurrentSelection";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />

}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
                <Items>
                    <f:Button Text="获取选中项" ID="btnSubmit" OnClick="@Url.Handler("btnSubmit_Click")" OnClickParameter1="@(Parameter.FromFunction("selected", "getDataList1SelectedPostbackValue"))"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1" Items="@ViewBag.DataList1Items" SelectedValueArray="@(new string[] { "cn", "us" })" EnableMultiSelect="true"
                KeepCurrentSelection="true" EnableSelect="true" DataValueField="Id">
            </f:DataList>
        </Items>
    </f:Panel>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getDataList1SelectedPostbackValue() {
            return F.ui.DataList1.getSelectedItems();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示移动列表连续点击累加选择，并通过按钮读取、设置或清空当前集合。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>修改并读取选择</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="DataList1"
                    title="数据列表">数据列表</strong>点击<code>中国</code>，再点击<code>法国</code>。<br />结果：两个项目可以累加到当前集合，不需要按键盘修饰键。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnSubmit" title="获取选中项">获取选中项</strong>。<br />结果：读取当前项目值或值数组，提示与列表现在的选择一致。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableSelect</code>（<strong class="example-control-reference" data-example-control="DataList1"
                    title="数据列表">数据列表</strong>）：初始为<code>true</code>，允许点击列表项目进行选择。</li>
            <li><code>SelectedValueArray</code>（<strong class="example-control-reference" data-example-control="DataList1"
                    title="数据列表">数据列表</strong>）：使用稳定的项目值记录当前选择，不依赖显示顺序。</li>
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DataList1"
                    title="数据列表">数据列表</strong>）：初始为<code>true</code>，允许选择集合包含多个项目。</li>
            <li><code>KeepCurrentSelection</code>（<strong class="example-control-reference" data-example-control="DataList1"
                    title="数据列表">数据列表</strong>）：初始为<code>true</code>，连续点击时保留已有选择。</li>
        </ul>
    </section>
}
