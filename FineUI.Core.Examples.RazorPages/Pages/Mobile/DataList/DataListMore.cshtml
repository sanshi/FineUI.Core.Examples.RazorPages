@page
@model FineUI.Core.Examples.RazorPages.Pages.Mobile.DataList.DataListMoreModel
@{
    ViewBag.Title = "MobileDataList/DataListMore";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />
    <style>
        .item-desc {
            word-break: break-all;
            white-space: normal;
        }

        .morebutton {
            width: 100%;
            text-align: center;
            margin: 8px 0;
        }
    </style>

}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1" Items="@ViewBag.DataList1Items">
                <Attributes>
                    <f:Attribute Key="data-index" Value="0"></f:Attribute>
                </Attributes>
            </f:DataList>
            <f:LinkButton runat="server" CssClass="morebutton" Text="加载更多..." ID="btnMore"
                          OnClick="@Url.Handler("btnMore_Click")" OnClickParameter1="@(new Parameter("dataIndex", "F.ui.DataList1.getAttr('data-index')"))"></f:LinkButton>
        </Items>
    </f:Panel>


}

